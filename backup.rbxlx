			<Item class="LocalScript" referent="RBX7F57A6071F4947E3AF79759BFDC10AD4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- BattlePassLocalScript - Client UI Controller
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local gui = script.Parent
local mainPanel = gui:WaitForChild("PanelPrincipal")
local openButton = gui:WaitForChild("BoutonOuvrirPass")

local header = mainPanel:FindFirstChild("Entete")
local closeButton = header and header:FindFirstChild("BoutonFermer")
local statsBar = mainPanel:FindFirstChild("ZoneStats")
local levelLabel = statsBar and statsBar:FindFirstChild("NiveauAffiche")
local xpBar = statsBar and statsBar:FindFirstChild("BarreXP")
local barFill = xpBar and xpBar:FindFirstChild("Remplissage")
local xpLabel = xpBar and xpBar:FindFirstChild("TexteXP")
local coinsLabel = statsBar and statsBar:FindFirstChild("CoinsAffiche")
local buyBtn = statsBar and statsBar:FindFirstChild("BoutonAcheterNiveau")
local premBtn = statsBar and statsBar:FindFirstChild("BoutonPremium")
local feedbackLabel = mainPanel:FindFirstChild("MessageRetour")
local rewardsFrame = mainPanel:FindFirstChild("Recompenses")
local scrollFrame = rewardsFrame and rewardsFrame:FindFirstChild("ListePaliers")
local freeRow = scrollFrame and scrollFrame:FindFirstChild("LigneGratuite")
local premRow = scrollFrame and scrollFrame:FindFirstChild("LignePremium")

local configModule = ReplicatedStorage:WaitForChild("BattlePassConfig", 10)
local Config = configModule and require(configModule) or { MaxLevel = 30, XPPerLevel = 1000 }

local claimRemote = ReplicatedStorage:WaitForChild("ClaimReward", 10)
local promptPremiumEvent = ReplicatedStorage:WaitForChild("PromptPremiumEvent", 10)
local promptPurchaseEvent = ReplicatedStorage:WaitForChild("PromptPurchaseEvent", 10)

local state = {
	level = 1,
	xp = 0,
	coins = 0,
	premium = false,
	claimed = {},
}
local panelOpen = false

local function setPanel(open)
	panelOpen = open
	mainPanel.Visible = open
	openButton.Visible = not open
	if open and scrollFrame then
		local CARD_W = 148
		local targetX = math.max(0, (state.level - 2) * CARD_W)
		scrollFrame.CanvasPosition = Vector2.new(targetX, 0)
	end
end

openButton.MouseButton1Click:Connect(function()
	setPanel(true)
end)

if closeButton then
	closeButton.MouseButton1Click:Connect(function()
		setPanel(false)
	end)
end

UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.B then
		setPanel(not panelOpen)
	end
end)

local function showFeedback(msg, isError)
	if not feedbackLabel then return end
	feedbackLabel.Text = msg
	feedbackLabel.TextColor3 = isError and Color3.fromRGB(240, 80, 80) or Color3.fromRGB(80, 230, 120)
	task.delay(3.5, function()
		if feedbackLabel.Text == msg then
			feedbackLabel.Text = ""
		end
	end)
end

local function updateXPBar()
	if levelLabel then
		levelLabel.Text = tostring(state.level)
	end
	if xpLabel then
		if state.level >= Config.MaxLevel then
			xpLabel.Text = "NIVEAU MAX"
		else
			xpLabel.Text = string.format("%d / %d XP", state.xp, Config.XPPerLevel)
		end
	end
	if barFill then
		local ratio = (state.level >= Config.MaxLevel) and 1 or math.clamp(state.xp / math.max(1, Config.XPPerLevel), 0, 1)
		TweenService:Create(barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(ratio, 0, 1, 0)
		}):Play()
	end
	if coinsLabel then
		coinsLabel.Text = tostring(state.coins)
	end
	if premBtn then
		if state.premium then
			premBtn.Text = "★ PREMIUM ACTIF"
			premBtn.BackgroundColor3 = Color3.fromRGB(60, 150, 70)
		else
			premBtn.Text = "☆ PASSER EN PREMIUM"
			premBtn.BackgroundColor3 = Color3.fromRGB(160, 80, 210)
		end
	end
end

local function updateCards()
	for lvl = 1, Config.MaxLevel do
		-- Piste Gratuite
		local freeCard = freeRow and freeRow:FindFirstChild("Palier" .. lvl)
		if freeCard then
			local key = "free_" .. tostring(lvl)
			local isClaimed = state.claimed[key] == true
			local isUnlocked = state.level >= lvl
			local claimBtn = freeCard:FindFirstChild("BoutonClaim")

			if claimBtn then
				if isClaimed then
					claimBtn.Text = "RÉCLAMÉ"
					claimBtn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
					claimBtn.TextColor3 = Color3.fromRGB(120, 130, 150)
					claimBtn.Active = false
				elseif isUnlocked then
					claimBtn.Text = "RÉCLAMER"
					claimBtn.BackgroundColor3 = Color3.fromRGB(45, 175, 85)
					claimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					claimBtn.Active = true
				else
					claimBtn.Text = "PALIER " .. lvl
					claimBtn.BackgroundColor3 = Color3.fromRGB(30, 34, 48)
					claimBtn.TextColor3 = Color3.fromRGB(90, 100, 120)
					claimBtn.Active = false
				end
			end

			local lockOverlay = freeCard:FindFirstChild("LockOverlay")
			if not isUnlocked and not lockOverlay then
				local ov = Instance.new("Frame")
				ov.Name = "LockOverlay"
				ov.Size = UDim2.new(1, 0, 1, 0)
				ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				ov.BackgroundTransparency = 0.55
				ov.BorderSizePixel = 0
				ov.ZIndex = 20
				ov.Parent = freeCard
				Instance.new("UICorner", ov).CornerRadius = UDim.new(0, 8)
			elseif isUnlocked and lockOverlay then
				lockOverlay:Destroy()
			end
		end

		-- Piste Premium
		local premCard = premRow and premRow:FindFirstChild("Palier" .. lvl)
		if premCard then
			local key = "premium_" .. tostring(lvl)
			local isClaimed = state.claimed[key] == true
			local isUnlocked = (state.level >= lvl) and state.premium
			local claimBtn = premCard:FindFirstChild("BoutonClaim")

			if claimBtn then
				if not state.premium then
					claimBtn.Text = "PREMIUM REQUIS"
					claimBtn.BackgroundColor3 = Color3.fromRGB(65, 35, 95)
					claimBtn.TextColor3 = Color3.fromRGB(190, 140, 255)
					claimBtn.Active = false
				elseif isClaimed then
					claimBtn.Text = "RÉCLAMÉ"
					claimBtn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
					claimBtn.TextColor3 = Color3.fromRGB(120, 130, 150)
					claimBtn.Active = false
				elseif isUnlocked then
					claimBtn.Text = "RÉCLAMER"
					claimBtn.BackgroundColor3 = Color3.fromRGB(140, 60, 210)
					claimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					claimBtn.Active = true
				else
					claimBtn.Text = "PALIER " .. lvl
					claimBtn.BackgroundColor3 = Color3.fromRGB(35, 25, 50)
					claimBtn.TextColor3 = Color3.fromRGB(90, 70, 110)
					claimBtn.Active = false
				end
			end

			local lockOverlay = premCard:FindFirstChild("LockOverlay")
			if not isUnlocked and not lockOverlay then
				local ov = Instance.new("Frame")
				ov.Name = "LockOverlay"
				ov.Size = UDim2.new(1, 0, 1, 0)
				ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
				ov.BackgroundTransparency = 0.55
				ov.BorderSizePixel = 0
				ov.ZIndex = 20
				ov.Parent = premCard
				Instance.new("UICorner", ov).CornerRadius = UDim.new(0, 8)
			elseif isUnlocked and lockOverlay then
				lockOverlay:Destroy()
			end
		end
	end
end

local function hookButtons()
	for lvl = 1, Config.MaxLevel do
		local freeCard = freeRow and freeRow:FindFirstChild("Palier" .. lvl)
		if freeCard then
			local btn = freeCard:FindFirstChild("BoutonClaim")
			if btn then
				local currentLvl = lvl
				btn.MouseButton1Click:Connect(function()
					if not btn.Active then return end
					if claimRemote then
						btn.Active = false
						local success, res = pcall(function()
							return claimRemote:InvokeServer(currentLvl, "free")
						end)
						if success and res == true then
							state.claimed["free_" .. currentLvl] = true
							showFeedback(string.format("Palier %d gratuit récupéré !", currentLvl))
							updateCards()
						else
							btn.Active = true
							showFeedback(tostring(res or "Erreur lors de la récupération"), true)
						end
					end
				end)
			end
		end

		local premCard = premRow and premRow:FindFirstChild("Palier" .. lvl)
		if premCard then
			local btn = premCard:FindFirstChild("BoutonClaim")
			if btn then
				local currentLvl = lvl
				btn.MouseButton1Click:Connect(function()
					if not btn.Active then
						if not state.premium then
							showFeedback("Tu as besoin du Battle Pass Premium !", true)
						end
						return
					end
					if claimRemote then
						btn.Active = false
						local success, res = pcall(function()
							return claimRemote:InvokeServer(currentLvl, "premium")
						end)
						if success and res == true then
							state.claimed["premium_" .. currentLvl] = true
							showFeedback(string.format("Palier %d premium récupéré !", currentLvl))
							updateCards()
						else
							btn.Active = true
							showFeedback(tostring(res or "Erreur lors de la récupération"), true)
						end
					end
				end)
			end
		end
	end

	if buyBtn then
		buyBtn.MouseButton1Click:Connect(function()
			if promptPurchaseEvent then
				promptPurchaseEvent:FireServer()
				showFeedback("Ouverture de l'achat de niveau...")
			end
		end)
	end

	if premBtn then
		premBtn.MouseButton1Click:Connect(function()
			if state.premium then
				showFeedback("Tu possèdes déjà le Battle Pass Premium !")
				return
			end
			if promptPremiumEvent then
				promptPremiumEvent:FireServer()
				showFeedback("Ouverture de l'achat Premium...")
			end
		end)
	end
end

local function syncFromPlayer()
	local lvlVal = player:FindFirstChild("BP_Level")
	local xpVal = player:FindFirstChild("BP_XP")
	local coinsVal = player:FindFirstChild("BP_Coins")
	local premVal = player:FindFirstChild("BP_Premium")
	local claimedFolder = player:FindFirstChild("BP_Claimed")

	if lvlVal and lvlVal:IsA("IntValue") then
		state.level = lvlVal.Value
	end
	if xpVal and xpVal:IsA("IntValue") then
		state.xp = xpVal.Value
	end
	if coinsVal and coinsVal:IsA("IntValue") then
		state.coins = coinsVal.Value
	end
	if premVal and premVal:IsA("BoolValue") then
		state.premium = premVal.Value
	end
	if claimedFolder and claimedFolder:IsA("Folder") then
		for _, child in ipairs(claimedFolder:GetChildren()) do
			if child:IsA("BoolValue") and child.Value == true then
				state.claimed[child.Name] = true
			end
		end
	end

	updateXPBar()
	updateCards()
end

local function bindDataListeners()
	local names = { "BP_Level", "BP_XP", "BP_Coins", "BP_Premium" }
	for _, n in ipairs(names) do
		local obj = player:FindFirstChild(n)
		if obj then
			obj.Changed:Connect(syncFromPlayer)
		end
	end

	local claimedFolder = player:FindFirstChild("BP_Claimed")
	if claimedFolder then
		claimedFolder.ChildAdded:Connect(function(child)
			if child:IsA("BoolValue") then
				child.Changed:Connect(syncFromPlayer)
			end
			syncFromPlayer()
		end)
	end

	player.ChildAdded:Connect(function(child)
		if table.find(names, child.Name) or child.Name == "BP_Claimed" then
			task.wait(0.1)
			syncFromPlayer()
			if child:IsA("ValueBase") then
				child.Changed:Connect(syncFromPlayer)
			elseif child.Name == "BP_Claimed" then
				child.ChildAdded:Connect(syncFromPlayer)
			end
		end
	end)
end

hookButtons()
syncFromPlayer()
bindDataListeners()

-- Attente active au lancement si les donnees mettent quelques secondes
task.spawn(function()
	local attempts = 0
	while attempts < 20 and not player:FindFirstChild("BP_Level") do
		task.wait(0.5)
		attempts += 1
		syncFromPlayer()
	end
	syncFromPlayer()
end)
]]></ProtectedString>
