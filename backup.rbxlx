					<Properties>
						<ProtectedString name="Source"><![CDATA[local CALIBRES = {
	".45 ACP", "9x19mm", ".50 AE", "12 Gauge", 
	".30-06 Springfield", "7.92x57mm Mauser", 
	"5.56x45mm NATO", "7.62x39mm"
}

game.Players.PlayerAdded:Connect(function(player)
	local ammoFolder = Instance.new("Folder")
	ammoFolder.Name = "AmmoInventory"
	ammoFolder.Parent = player

	for _, nombreCalibre in ipairs(CALIBRES) do
		local ammoValue = Instance.new("IntValue")
		ammoValue.Name = nombreCalibre
		ammoValue.Value = 0 -- Empiezan con 0 balas
		ammoValue.Parent = ammoFolder
	end
end)]]></ProtectedString>
