						<Item class="MeshPart" referent="RBX1AD3FC5B81024454BC9969CC78ABD01E">
							<Properties>
								<bool name="DoubleSided">true</bool>
								<bool name="HasJointOffset">false</bool>
								<bool name="HasSkinnedMesh">false</bool>
								<Vector3 name="InitialSize">
									<X>3.78343105</X>
