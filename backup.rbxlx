			<Item class="LocalScript" referent="RBX315CA28F7F0A4B419970AE3FFDB75054">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local Barrel = Tool:FindFirstChild("Barrel", true)
local DisparoEvent = Tool:WaitForChild("DisparoEvent")

local MAX_BALAS = 30
local CALIBRE = "7.62x39mm"
local CADENCIA = 0.1 -- Velocidad de ráfaga
local disparando = false

if Tool:GetAttribute("Balas") == nil then Tool:SetAttribute("Balas", MAX_BALAS) end

local function getAmmoValue()
	local inv = Player:FindFirstChild("AmmoInventory")
	return inv and inv:FindFirstChild(CALIBRE)
end

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild("PlayerGui")
	local gui = pGui and pGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		local ammoVal = getAmmoValue()
		local textLabel = gui:FindFirstChild("AmmoText", true) 
		if textLabel then
			textLabel.Text = Tool:GetAttribute("Balas") .. " / " .. (ammoVal and ammoVal.Value or 0)
		end
	end
end

local function unDisparo()
	local balas = Tool:GetAttribute("Balas")
	if balas <= 0 or Tool:GetAttribute("Recargando") or not Barrel then 
		if balas <= 0 then DisparoEvent:FireServer(nil, 0, "sonido_vacio") end
		disparando = false
		return 
	end

	Tool:SetAttribute("Balas", balas - 1)
	actualizarGUI(true)
	DisparoEvent:FireServer(nil, 0, "sonido_disparo")

	-- Bala visual
	local p = Instance.new("Part")
	p.Size = Vector3.new(0.3, 0.3, 0.3); p.Color = Color3.fromRGB(255, 180, 50); p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false; p.Position = Barrel.Position; p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 2)

	local dir = Camera.CFrame.LookVector
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {Character, Tool}
		local result = workspace:Raycast(p.Position, dir * (850 * dt), rayParams)
		if result then
			local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
			if hum then DisparoEvent:FireServer(hum, 35) end -- Daño balanceado para automática
			p:Destroy(); connection:Disconnect()
		else
			p.Position += dir * (850 * dt)
		end
	end)
end

local function recargar()
	local ammoVal = getAmmoValue()
	local balasActuales = Tool:GetAttribute("Balas")
	if not ammoVal or ammoVal.Value <= 0 or balasActuales == MAX_BALAS or Tool:GetAttribute("Recargando") then return end

	disparando = false
	Tool:SetAttribute("Recargando", true)
	DisparoEvent:FireServer(nil, 0, "sonido_recarga")

	local anim = Tool:FindFirstChild("RecargarAnim")
	if anim then
		local rt = Humanoid:LoadAnimation(anim)
		rt.Priority = Enum.AnimationPriority.Action4
		rt:Play()
		rt.Stopped:Wait()
	else
		task.wait(2.5)
	end

	local falta = MAX_BALAS - balasActuales
	if ammoVal.Value >= falta then
		ammoVal.Value -= falta; Tool:SetAttribute("Balas", MAX_BALAS)
	else
		Tool:SetAttribute("Balas", balasActuales + ammoVal.Value); ammoVal.Value = 0
	end

	Tool:SetAttribute("Recargando", false)
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then 
		disparando = true
		while disparando and Tool.Parent == Character do
			unDisparo()
			task.wait(CADENCIA)
		end
	elseif input.KeyCode == Enum.KeyCode.R then 
		recargar() 
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparando = false end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() actualizarGUI(false); disparando = false end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{5EC68E24-6023-4AAB-A55C-B829E9FF97F5}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">18014364149484288</SecurityCapabilities>
					<bool name="DefinesCapabilities">true</bool>
					<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db7100001114</UniqueId>
					<string name="Name">ReplicatedStorage_Disparar</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
