				</Item>
				<Item class="Script" referent="RBX1C3BF53A370B42ADB61F27B9FE2E34F6">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Remote = Tool:WaitForChild("DisparoEvent")

-- Función para sonido 3D desde el Barrel
local function reproducirSonido(nombre, barrel)
	if not barrel then return end

	-- Busca el sonido dentro de la Tool
	local sonidoOriginal = Tool:FindFirstChild(nombre, true)
	if not sonidoOriginal then return end

	local clon = sonidoOriginal:Clone()
	clon.Parent = barrel -- Se pone en el barrel para que sea 3D
	clon:Play()

	game:GetService("Debris"):AddItem(clon, clon.TimeLength + 1)
end

Remote.OnServerEvent:Connect(function(player, humanoid, danio, accion)
	local character = player.Character
	-- Intentamos encontrar el Barrel de la herramienta que tiene equipada el personaje
	local barrel = character and character:FindFirstChild("Barrel", true)

	if accion == "sonido_disparo" then
		reproducirSonido("SonidoDisparo", barrel)
		return
	elseif accion == "sonido_recarga" then
		reproducirSonido("SonidoRecarga", barrel)
		return
	elseif accion == "sonido_vacio" then
		reproducirSonido("SonidoVacio", barrel)
		return
	end

	-- Aplicar daño
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid:TakeDamage(danio)
	end
end)]]></ProtectedString>
