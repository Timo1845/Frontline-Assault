									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
									<UniqueId name="UniqueId">1333d5215a2be5650b0775a300000be5</UniqueId>
								</Properties>
							</Item>
						</Item>
