			<Item class="Script" referent="RBXEFEF5B8BDCBA42D4901B693CCABB2DE7">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- SCRIPT DE SERVIDOR (Server Script)
local Tool = script.Parent
local Remote = Tool:WaitForChild("DisparoEvent")

Remote.OnServerEvent:Connect(function(player, targetHum, damage)
	-- Verificación básica de seguridad
	if targetHum and targetHum:IsA("Humanoid") and targetHum.Health > 0 then
		-- Si es un zombie o jugador, le restamos vida
		targetHum:TakeDamage(damage)

		-- Opcional: Sangre o efecto de impacto
		local root = targetHum.Parent:FindFirstChild("HumanoidRootPart")
		if root then
			print("Impacto de escopeta en: " .. targetHum.Parent.Name)
		end
	end
end)]]></ProtectedString>
