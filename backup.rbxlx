			<Item class="LocalScript" referent="RBX926F73D1E834452995BDCFCB9CE040F4">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

-- Referencias
local IsAimingValue = Tool:WaitForChild("IsAiming")
local Barrel = Tool:FindFirstChild("Barrel", true)
local DisparoEvent = Tool:WaitForChild("DisparoEvent")

-- CONFIGURACIÓN GLOCK
local CALIBRE = "9x19mm"
local MAX_BALAS = 17
local balasActuales = 17
local recargando = false

local function obtenerReserva()
	local inventory = Player:FindFirstChild("AmmoInventory")
	return inventory and inventory:FindFirstChild(CALIBRE)
end

local function actualizarGUI(visible)
	local gui = Player.PlayerGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		local ammoVal = obtenerReserva()
		gui.Frame.AmmoText.Text = balasActuales .. " / " .. (ammoVal and ammoVal.Value or 0)
	end
end

local function disparar()
	if recargando or balasActuales <= 0 or not Barrel or Tool.Parent ~= Character then 
		if balasActuales <= 0 and not recargando then DisparoEvent:FireServer(nil, 0, "sonido_vacio") end
		return 
	end

	balasActuales -= 1
	actualizarGUI(true)
	DisparoEvent:FireServer(nil, 0, "sonido_disparo")

	local p = Instance.new("Part")
	p.Size = Vector3.new(0.3, 0.3, 0.3); p.Color = Color3.fromRGB(255, 200, 50); p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false; p.Position = Barrel.Position; p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 2)

	local dir = Camera.CFrame.LookVector
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		if not p or not p.Parent then connection:Disconnect() return end
		local paso = dir * (600 * dt)
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {Character, Tool} -- Ignora arma y jugador
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local result = workspace:Raycast(p.Position, paso, rayParams)
		if result then
			local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
			if hum then DisparoEvent:FireServer(hum, 25) end
			p:Destroy(); connection:Disconnect()
		else
			p.Position += paso
		end
	end)
end

local function recargar()
	local ammoVal = obtenerReserva()
	if recargando or not ammoVal or ammoVal.Value <= 0 or balasActuales == MAX_BALAS then return end

	recargando = true
	DisparoEvent:FireServer(nil, 0, "sonido_recarga")

	local animObj = Tool:FindFirstChild("RecargarAnim")
	if animObj then
		local loadAnim = Humanoid:LoadAnimation(animObj)
		loadAnim.Priority = Enum.AnimationPriority.Action4 -- Gana a todo

		-- Detener animaciones de apuntado para que no se crucen
		for _, track in pairs(Humanoid:GetPlayingAnimationTracks()) do
			if track.Name == "Apuntar" then track:Stop(0.1) end
		end

		loadAnim:Play(0.1)
		loadAnim.Stopped:Wait()
	else
		task.wait(1.5)
	end

	local falta = MAX_BALAS - balasActuales
	if ammoVal.Value >= falta then
		ammoVal.Value -= falta; balasActuales = MAX_BALAS
	else
		balasActuales += ammoVal.Value; ammoVal.Value = 0
	end

	recargando = false
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparar()
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() actualizarGUI(false) end)]]></ProtectedString>
