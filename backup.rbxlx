							<UniqueId name="UniqueId">1333d5215a2be5650b0775a300000bf1</UniqueId>
						</Properties>
						<Item class="NumberPose" referent="RBXE4D07D5F00064D36B039D2D784D51557">
							<Properties>
								<double name="Value">130049213376589</double>
								<token name="EasingDirection">0</token>
								<token name="EasingStyle">0</token>
								<float name="Weight">1</float>
