		<Item class="Script" referent="RBX2EC781E5D7704FC49FAF8ED3036A284B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- SkinManager (serveur)
-- Applique aux armes de la map les skins et materiaux debloques dans Player.BP_Skins.
-- Supporte la couleur, le materiau (Metal, Neon, Slate, DiamondPlate...) et les textures.

local Players = game:GetService("Players")

local SKINS = {
	-- Piste Gratuite
	Glock_Camo = {
		weapon = "Glock",
		priority = 1,
		color = Color3.fromRGB(68, 88, 56), -- Vert camouflage militaire mat
		material = Enum.Material.Slate,
		textureId = "",
	},
	MP7A1_Cobalt = {
		weapon = "MP7A1",
		priority = 1,
		color = Color3.fromRGB(35, 75, 150), -- Bleu cobalt metallise
		material = Enum.Material.Metal,
		textureId = "",
	},
	MK18_SpecOps = {
		weapon = "MK-18",
		priority = 1,
		color = Color3.fromRGB(28, 30, 34), -- Noir furtif SpecOps texture carbone
		material = Enum.Material.DiamondPlate,
		textureId = "",
	},

	-- Piste Premium
	Glock_Rouge = {
		weapon = "Glock",
		priority = 2,
		color = Color3.fromRGB(185, 35, 45), -- Rouge rubis brillant
		material = Enum.Material.Metal,
		textureId = "",
	},
	Deagle_Neon = {
		weapon = "Desert Eagle",
		priority = 1,
		color = Color3.fromRGB(0, 230, 255), -- Cyan electrique lumineux
		material = Enum.Material.Neon,
		textureId = "",
	},
	M4A1_Carbone = {
		weapon = "M4A1",
		priority = 1,
		color = Color3.fromRGB(45, 48, 55), -- Gris carbone renforce
		material = Enum.Material.DiamondPlate,
		textureId = "",
	},
	AK47_Or = {
		weapon = "Ak47",
		priority = 2,
		color = Color3.fromRGB(255, 215, 0), -- Or prestige etincelant
		material = Enum.Material.Metal,
		textureId = "",
	},
}

local originalLooks = setmetatable({}, { __mode = "k" })
local toolConnections = setmetatable({}, { __mode = "k" })
local watchedSkinFolders = setmetatable({}, { __mode = "k" })

local function captureOriginal(tool, part)
	local look = originalLooks[tool]
	if not look then
		look = {}
		originalLooks[tool] = look
	end

	if look[part] then
		return look[part]
	end

	local original = { color = part.Color, material = part.Material }
	if part:IsA("MeshPart") then
		original.textureId = part.TextureID
	end
	look[part] = original
	return original
end

local function restoreOriginal(tool)
	local look = originalLooks[tool]
	if not look then
		return
	end

	for part, original in pairs(look) do
		if part.Parent then
			part.Color = original.color
			if original.material then
				part.Material = original.material
			end
			if part:IsA("MeshPart") and original.textureId ~= nil then
				part.TextureID = original.textureId
			end
		end
	end
end

local function findBestOwnedSkin(player, weaponName)
	local folder = player:FindFirstChild("BP_Skins")
	if not folder then
		return nil
	end

	local bestSkin
	local bestPriority = -math.huge
	for skinId, definition in pairs(SKINS) do
		if definition.weapon == weaponName and definition.priority > bestPriority then
			local ownedFlag = folder:FindFirstChild(skinId)
			if ownedFlag and ownedFlag:IsA("BoolValue") and ownedFlag.Value then
				bestSkin = definition
				bestPriority = definition.priority
			end
		end
	end
	return bestSkin
end

local function applySkinToTool(player, tool)
	if not tool or not tool:IsA("Tool") then
		return
	end

	local skin = findBestOwnedSkin(player, tool.Name)
	restoreOriginal(tool)
	if not skin then
		return
	end

	local textureId = skin.textureId
	for _, descendant in ipairs(tool:GetDescendants()) do
		if descendant:IsA("BasePart") then
			captureOriginal(tool, descendant)
			if descendant:IsA("MeshPart") and textureId and textureId ~= "" then
				descendant.TextureID = textureId
			else
				descendant.Color = skin.color
			end
			if skin.material then
				descendant.Material = skin.material
			end
		end
	end

	if not toolConnections[tool] then
		toolConnections[tool] = tool.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("BasePart") then
				task.defer(applySkinToTool, player, tool)
			end
		end)
	end
end

local function applyToCurrentTools(player)
	local function inspectContainer(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") then
				applySkinToTool(player, child)
			end
		end
	end

	inspectContainer(player:FindFirstChildOfClass("Backpack"))
	inspectContainer(player.Character)
end

local function watchSkinFolder(player, folder)
	if watchedSkinFolders[folder] then return end
	watchedSkinFolders[folder] = true

	folder.ChildAdded:Connect(function(child)
		if child:IsA("BoolValue") then
			child.Changed:Connect(function()
				applyToCurrentTools(player)
			end)
			applyToCurrentTools(player)
		end
	end)

	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BoolValue") then
			child.Changed:Connect(function()
				applyToCurrentTools(player)
			end)
		end
	end
	applyToCurrentTools(player)
end

local function watchContainer(player, container)
	if not container then return end
	container.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			applySkinToTool(player, child)
		end
	end)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") then
			applySkinToTool(player, child)
		end
	end
end

local function setupPlayer(player)
	local skinFolder = player:FindFirstChild("BP_Skins")
	if skinFolder then
		watchSkinFolder(player, skinFolder)
	end

	player.ChildAdded:Connect(function(child)
		if child.Name == "BP_Skins" and child:IsA("Folder") then
			watchSkinFolder(player, child)
		elseif child:IsA("Backpack") then
			watchContainer(player, child)
		end
	end)

	local function onCharacterAdded(character)
		watchContainer(player, character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		watchContainer(player, backpack)
	end
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

print("[SkinManager] Updated - Real weapons & Procedural materials enabled")
]]></ProtectedString>
