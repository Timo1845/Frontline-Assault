		<Item class="Script" referent="RBX6143EC99B1254C66AB039EC4ADC48DAF">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- LegacyWeaponSecurity v3 - Detection amelioree, anti-triche et integration Battle Pass XP
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local ServerScriptService = game:GetService("ServerScriptService")

local MAX_DAMAGE = 100
local MIN_INTERVAL = 0.05 -- 20 tirs/seconde max

local lastShot = {}

Players.PlayerAdded:Connect(function(player)
	lastShot[player.UserId] = 0
end)

Players.PlayerRemoving:Connect(function(player)
	lastShot[player.UserId] = nil
end)

local function tagHumanoid(humanoid, player)
	local creator = humanoid:FindFirstChild("creator")
	if not creator then
		creator = Instance.new("ObjectValue")
		creator.Name = "creator"
		creator.Parent = humanoid
	end
	creator.Value = player
	Debris:AddItem(creator, 3)
end

local function fireElimination(killer, victimHumanoid, dmg)
	local blasterFolder = ServerScriptService:FindFirstChild("Blaster")
	local eventsFolder = blasterFolder and blasterFolder:FindFirstChild("Events")
	local elimEvent = eventsFolder and eventsFolder:FindFirstChild("Eliminated")
	if elimEvent and elimEvent:IsA("BindableEvent") then
		elimEvent:Fire(killer, victimHumanoid, dmg)
	end
end

local function hookWeapon(weapon)
	local remote = weapon:FindFirstChild("DisparoEvent")
	if not remote then return end

	remote.OnServerEvent:Connect(function(player, humanoid, damage, action)
		-- Ignorer les actions purement audio / visuelles
		if action ~= nil then return end

		-- Validation de la cadence
		local now = tick()
		local uid = player.UserId
		if (now - (lastShot[uid] or 0)) < MIN_INTERVAL then
			return
		end
		lastShot[uid] = now

		-- Validation de la cible et des degats
		if not humanoid or not humanoid:IsA("Humanoid") then return end
		if not damage or damage <= 0 or damage > MAX_DAMAGE then return end

		local targetModel = humanoid:FindFirstAncestorOfClass("Model")
		if not targetModel then return end

		-- Pas d'auto-degats
		if player.Character == targetModel then return end

		-- Verification de sante avant application
		local wasAlive = humanoid.Health > 0
		tagHumanoid(humanoid, player)
		humanoid:TakeDamage(damage)

		-- Si ce tir est le coup fatal, declarer l'elimination pour le Battle Pass
		if wasAlive and humanoid.Health <= 0 then
			fireElimination(player, humanoid, damage)
		end
	end)
end

local RS = game:GetService("ReplicatedStorage")
local weapons = RS:FindFirstChild("Weapons")
if weapons then
	for _, w in ipairs(weapons:GetChildren()) do
		hookWeapon(w)
	end
	weapons.ChildAdded:Connect(hookWeapon)
end

print("[LegacyWeaponSecurity] v3 Active - Battle Pass XP Integration enabled")
]]></ProtectedString>
