			<Item class="LocalScript" referent="RBXDDC31A0ED490496BB3AF671EBC187CFE">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Keep the match HUD synchronized with replicated server state.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local matchState = ReplicatedStorage:WaitForChild("MatchState", 10)
if not matchState then
	warn("[MatchHUD] ReplicatedStorage.MatchState is missing.")
	return
end

local timerStatus = matchState:WaitForChild("TimerStatus", 10)
local scoreSpecOps = matchState:WaitForChild("Score_SpecOps", 10)
local scoreOpFor = matchState:WaitForChild("Score_OpFor", 10)
local gui = script.Parent
local timerLabel = gui:FindFirstChild("TimerLabel")
local specOpsLabel = gui:FindFirstChild("SpecOpsLabel")
local opForLabel = gui:FindFirstChild("OpForLabel")

if not timerStatus or not scoreSpecOps or not scoreOpFor then
	warn("[MatchHUD] MatchState is missing one or more values.")
	return
end

local function updateTimer()
	if timerLabel and timerLabel:IsA("TextLabel") then
		timerLabel.Text = timerStatus.Value
	end
end

local function updateScores()
	if specOpsLabel and specOpsLabel:IsA("TextLabel") then
		specOpsLabel.Text = "Spec Ops : " .. tostring(scoreSpecOps.Value)
	end
	if opForLabel and opForLabel:IsA("TextLabel") then
		opForLabel.Text = "OpFor : " .. tostring(scoreOpFor.Value)
	end
end

timerStatus.Changed:Connect(updateTimer)
scoreSpecOps.Changed:Connect(updateScores)
scoreOpFor.Changed:Connect(updateScores)
updateTimer()
updateScores()
]]></ProtectedString>
