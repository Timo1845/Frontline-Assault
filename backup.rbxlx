				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")
local Remote = Tool:WaitForChild("DisparoEvent")

-- Configuración del sonido de "clic"
local SoundEmpty = Instance.new("Sound")
SoundEmpty.Name = "SonidoVacio"
SoundEmpty.SoundId = "rbxassetid://116664883827057" -- Sonido de clic seco
SoundEmpty.Volume = 0.6
SoundEmpty.Parent = Handle

Remote.OnServerEvent:Connect(function(player, targetHum)
	-- Obtenemos las balas actuales del atributo
	local balas = Tool:GetAttribute("Balas") or 0

	-- Si el jugador intenta disparar (targetHum es nil) y no hay balas
	if balas <= 0 then
		SoundEmpty:Play()
	end
end)]]></ProtectedString>
