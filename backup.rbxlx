				<Item class="LocalScript" referent="RBX7A941F94803D46B28128973F1AD26DB9">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local Barrel = Tool:WaitForChild("Body"):WaitForChild("Barrel")
local IsAimingValue = Tool:FindFirstChild("IsAiming") or Instance.new("BoolValue", Tool)
IsAimingValue.Name = "IsAiming"
local function getAmmoValue()
	local inv = Player:FindFirstChild("AmmoInventory")
	return inv and inv:FindFirstChild(".45 ACP")
end

local MAX_BALAS = 30
local balasActuales = 30
local recargando = false

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild("PlayerGui")
	local gui = pGui and pGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		if visible then
			gui.Frame.AmmoText.Text = balasActuales .. " / " .. (getAmmoValue() and getAmmoValue().Value or 0) 
		end
	end
end

local function crearBolita()
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.4, 0.4, 0.4)
	p.Color = Color3.fromRGB(255, 120, 0)
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.Position = Barrel.Position
	p.Parent = workspace

	local a0 = Instance.new("Attachment", p); a0.Position = Vector3.new(0,0.2,0)
	local a1 = Instance.new("Attachment", p); a1.Position = Vector3.new(0,-0.2,0)
	local t = Instance.new("Trail", p); t.Attachment0 = a0; t.Attachment1 = a1
	t.Color = ColorSequence.new(p.Color); t.Lifetime = 0.1
	return p
end

local function disparar()
	if recargando or not Barrel then return end

	-- LÓGICA DE SIN BALAS (Sonido de clic para todos)
	if balasActuales <= 0 then
		Tool.DisparoEvent:FireServer(nil, 0, "sonido_vacio")
		return 
	end

	balasActuales -= 1
	actualizarGUI(true)

	-- Avisar al servidor para el SONIDO de disparo global
	Tool.DisparoEvent:FireServer(nil, 0, "sonido_disparo")

	local proyectil = crearBolita()
	local direccion = Camera.CFrame.LookVector
	local distancia = 0

	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local paso = direccion * (450 * dt)
		local result = workspace:Raycast(proyectil.Position, paso, RaycastParams.new())

		if result then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChild("Humanoid")

			-- Avisar al servidor para el DAÑO
			if hum then Tool.DisparoEvent:FireServer(hum, 20) end

			proyectil:Destroy(); connection:Disconnect()
		else
			proyectil.Position += paso
			distancia += paso.Magnitude
			if distancia > 300 then proyectil:Destroy(); connection:Disconnect() end
		end
	end)
end

local function recargar()
	if recargando or (getAmmoValue() and getAmmoValue().Value or 0) <= 0 or balasActuales == MAX_BALAS then return end
	recargando = true

	-- Avisar al servidor para el SONIDO de recarga global
	Tool.DisparoEvent:FireServer(nil, 0, "sonido_recarga")

	local anim = Tool:FindFirstChild("RecargarAnim")
	if anim then
		local rt = Humanoid:LoadAnimation(anim)
		rt.Priority = Enum.AnimationPriority.Action4
		rt:Play()
		rt.Stopped:Wait()
	end

	local falta = MAX_BALAS - balasActuales
	local ammoObj = getAmmoValue()
	if (getAmmoValue() and getAmmoValue().Value or 0) >= falta then
		if ammoObj then ammoObj.Value -= falta end
		balasActuales = MAX_BALAS
	else
		balasActuales += (getAmmoValue() and getAmmoValue().Value or 0)
		if ammoObj then ammoObj.Value = 0 end
	end
	recargando = false
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		disparar()
	elseif input.KeyCode == Enum.KeyCode.R then
		recargar()
	end
end)

RunService.RenderStepped:Connect(function()
	if IsAimingValue.Value and RootPart and Tool.Parent == Character then
		local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
		RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, rot + math.pi, 0)
	end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() 
	actualizarGUI(false) 
	recargando = false
end)
MiMunicion.Changed:Connect(function() if Tool.Parent == Character then actualizarGUI(true) end end)]]></ProtectedString>
