			<Item class="LocalScript" referent="RBXD298E12FD7AE457EBB9D6092FEDB3D7D">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local player = game:GetService("Players").LocalPlayer
local mouse = player:GetMouse()

-- REEMPLAZA LOS NÚMEROS DE ABAJO CON TU ID DE DECAL
local crosshairID = "http://www.roblox.com/asset/?id=9524023207"

tool.Equipped:Connect(function()
	mouse.Icon = crosshairID
end)

tool.Unequipped:Connect(function()
	mouse.Icon = "" -- Esto vuelve el puntero a la normalidad
end)]]></ProtectedString>
