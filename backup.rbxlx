			<Item class="ModuleScript" referent="RBX5ED82D73985844A1A0753DFE5DDB2D05">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[ Edited Version
====================================================================================================
Weapons and Tools Pack 2016's Gun by SuperEvilAzmil and edited by thienbao2109

Features:
- FilteringEnabled support
- Easy to edit with a bunch of settings
- No delays between Mouse Click and Gun Fire
====================================================================================================
]]

local Module = {
--	====================
--	BASIC
--	A basic settings for the gun
--	====================

		Auto = true;
		BaseDamage = 27;
		FireRate = 0.110; --In second
		ReloadTime = 2.42; --In second
		EquippingTime = 0; --In second
		AmmoPerMag = 30; --Put "math.huge" to make this gun has infinite ammo and never reload
		SpreadX = 1; --In degree
		SpreadY = 1.5; --In degree
		Range = 5000; --The furthest distance the bullet can travel
		HeadshotEnabled = true; --Enable the gun to do extra damage on headshot
		HeadshotDamageMultiplier = 1.3;
	IdleAnimationID = 11226713702; --Set to "nil" if you don't want to animate
		IdleAnimationSpeed = 1;
	FireAnimationID = 11226748168; --Set to "nil" if you don't want to animate
		FireAnimationSpeed = 1;
	ReloadAnimationID = 11227109218; --Set to "nil" if you don't want to animate
		ReloadAnimationSpeed = 1;
	EquippedAnimationID = nil; --Set to "nil" if you don't want to animate
		EquippedAnimationSpeed = 1;
		
--	====================
--	WALK SPEED REDUTION
--	Nerf chraracter's walk speed when equip the gun
--	====================

        WalkSpeedRedutionEnabled = false;
        WalkSpeedRedution = 6;
		
--	====================
--	HOLD DOWN ANIMATION
--	Character won't fire if hold down the gun
--	====================

        HoldDownEnabled = true;
	HoldDownAnimationID = 11235640686;
        HoldDownAnimationSpeed = 1;
		
--	====================
--	BULLET HOLE VISUALIZER
--	Create a bullet hole when a bullet hit something but not character
--	====================

        BulletHoleEnabled = true;
        BulletHoleSize = 0.5;
        BulletHoleTexture = {2078626}; --You can insert more IDs
        BulletHoleVisibleTime = 3; --In second
        BulletHoleFadeTime = 1; --In second
        PartColor = true; --Set to hit object color
		
--	====================
--	HIT VISUALIZER
--	Create hit effect when a bullet hit something but not character(And hit sound, too)
--	====================

        HitEffectEnabled = true;
		HitSoundIDs = {186809061, 186809249, 186809250, 186809252};
		HitSoundPitch = math.random(90,110)/100; --I set it to "math.random" to makes it better. If you don't want it, then set it whatever you want(Default is 1)
		HitSoundVolume = 1;
        CustomHitEffect = false; --Emits your custom hit effect. NOTE: If you this setting disabled, hit effect will set to default(material tracker included)

--	====================
--	BLOOD VISUALIZER
--	Create blood when a bullet hit character(And hit character sound, too)
--	====================

        BloodEnabled = false;
		HitCharSndIDs = {245630921, 245630994, 245631056, 245631112, 245631167};
		HitCharSndPitch = 1; --Default is 1
		HitCharSndVolume = 1;
		FleshHole = true;
		FleshHoleSize = 0.5;
        FleshHoleTexture = {2078626}; --You can insert more IDs
        FleshHoleVisibleTime = 3; --In second
        FleshHoleFadeTime = 1; --In second
        FleshHoleColor = Color3.fromRGB(255, 0, 0);
		
--	====================
--	TWEEN SETTING
--	Part of ironsight and sniper aim
--	====================

        TweenLength = 0.8; --In second
        EasingStyle = Enum.EasingStyle.Quint; --Linear, Sine, Back, Quad, Quart, Quint, Bounce or Elastic?
        EasingDirection = Enum.EasingDirection.Out; --In, Out or InOut?

--	====================
--	TWEEN SETTING(NO AIM DOWN)
--	Part of ironsight and sniper aim
--	====================

        TweenLengthNAD = 0.8; --In second
        EasingStyleNAD = Enum.EasingStyle.Quint; --Linear, Sine, Back, Quad, Quart, Quint, Bounce or Elastic?
        EasingDirectionNAD = Enum.EasingDirection.Out; --In, Out or InOut?
		
--	====================
--	BULLET WHIZZING SOUND
--	Create a sound when a bullet travelling through character(or camera)
--	====================

        WhizSoundEnabled = true;
        WhizSoundID = {269514869, 269514887, 269514807, 269514817};
        WhizSoundVolume = 0.5;
        WhizSoundPitch = 1; --Default is 1
		
--	====================
--	HITMARKER
--	Mark on somewhere when a bullet hit character
--	====================

        HitmarkerEnabled = true;
        --Normal
        HitmarkerColor = Color3.fromRGB(255, 255, 255);
        HitmarkerFadeTime = 0.4;
        HitmarkerSoundPitch = 1;
        --Headshot
        HitmarkerColorHS = Color3.fromRGB(255, 0, 0);
        HitmarkerFadeTimeHS = 0.4;
        HitmarkerSoundPitchHS = 0.75;

--	====================
--	CROSSHAIR
--	A gun cursor
--	====================

        CrossSize = 7;
        CrossExpansion = 100;
        CrossSpeed = 15;
        CrossDamper	= 0.8;
		
--	====================
--	MUZZLE
--	Create a muzzle flash when firing
--	====================
        
        MuzzleFlashEnabled = true;
        MuzzleLightEnabled = true;
        LightBrightness = 4;
        LightColor = Color3.new(255/255, 283/255, 0/255);
        LightRange = 15;
        LightShadows = true;
        VisibleTime = 0.01; --In second
		
--	====================
--	BULLET SHELL EJECTION
--	Eject bullet shells when firing
--	====================

		BulletShellEnabled = true;
		BulletShellOffset = Vector3.new(0, 0.4, 0);
		ShellSize = Vector3.new(0.2, 0.2, 0.32); --Scale the part
		AllowCollide = false; --If false, a bullet shell will go through any parts
		ShellScale = Vector3.new(1.5, 1.5, 1.5); --Scale mesh
		ShellMeshID = 95392019;
		ShellTextureID = 95391833;
		DisappearTime = 5; --In second
		
--      You can edit velocity by go to GunScript_Local, and scroll down until you see "function EjectShell(ShootingHandle)"
		
--	====================
--	IRONSIGHT
--	Allow user to ironsighting
--	====================

		IronsightEnabled = true; --NOTE: If "SniperEnabled" is enabled, this setting is not work
		FieldOfViewIS = 50;
		MouseSensitiveIS = 0.2; --In percent
		SpreadRedutionIS = 0.6; --In percent. NOTE: Must be the same value as "SpreadRedutionS"
		CrossScaleIS = 0.6;
		
--	====================
--	LIMITED AMMO
--	Make a gun has a limit ammo
--	====================

		LimitedAmmoEnabled = true;
		Ammo = 360;
		MaxAmmo = 360; --Put "math.huge" to allow user to carry unlimited ammo
		
--	====================
--	SHOTGUN
--	Enable the gun to fire multiple bullet in one shot
--	====================

		ShotgunEnabled = false;
		BulletPerShot = 8;
		
		ShotgunReload = false; --Make user reloading like Shotgun, which user clipin shell one by one
		ShotgunClipinAnimationID = nil; --Set to "nil" if you don't want to animate
		ShotgunClipinAnimationSpeed = 1;
		ShellClipinSpeed = 0.5; --In second
		
--		How "ShotgunEnabled" work [Example]:

--		Play "ShotgunClipinAnimation" + Play "ShotgunClipin" Audio
--		>>>
--		Wait "ShellClipinSpeed" second
--		>>>
--		Repeat "AmmoPerClip" - "Current Ammo" times
--		>>>
--		Play "ReloadAnimation" + Play "ReloadSound"
--		Wait "ReloadTime"
		
--	====================
--	BURST FIRE
--	Enable the gun to do burst firing like Assault Rifle
--	====================

		BurstFireEnabled = false;
		BulletPerBurst = 3;
		BurstRate = 0.075; --In second
		
--	====================
--	SNIPER
--	Enable user to use scope
--	====================

		SniperEnabled = false; --NOTE: If "IronsightEnabled" is enabled, this setting is not work
		FieldOfViewS = 12.5;
		MouseSensitiveS = 0.2; --In percent
		SpreadRedutionS = 0.6; --In percent. NOTE: Must be the same value as "SpreadRedutionOS"
		CrossScaleS = 0;
		
--	====================
--	CAMERA RECOILING
--	Make user's camera recoiling when shooting
--	====================

		CameraRecoilingEnabled = true;
		Recoil = 6;
		AngleX_Min = 1; --In degree
		AngleX_Max = 1; --In degree
		AngleY_Min = 0; --In degree
		AngleY_Max = 0; --In degree
		AngleZ_Min = -1; --In degree
		AngleZ_Max = 1; --In degree
        Accuracy = 0.1; --In percent. For example: 0.5 is 50%
        RecoilSpeed = 10; 
        RecoilDamper = 0.35;
		RecoilRedution = 0.12; --In percent.
		
--	====================
--	EXPLOSIVE
--	Make a bullet explosive so user can deal a damage to multiple enemy in single shot. NOTE: Explosion won't break joints
--	====================

		ExplosiveEnabled = false;
		ExplosionSoundEnabled = true;
		ExplosionSoundIDs = {163064102};
		ExplosionSoundPitch = 1; --Default is 1
		ExplosionSoundVolume = 1;
		ExplosionRadius = 8;
		CustomExplosion = false;
		
--	====================
--	BULLET VISUALIZER
--	Enabled the gun to display a travelling bullet
--	====================

		BulletTracerEnabled = true; --Create a tracer for the bullet when firing
		BulletParticleEnaled = false; --Create a particle effect for bullet when firing
		BulletTracerOffset0 = Vector3.new(0.3, 0, 0); --NOTE: Bullet tracer size is depends on position between two attachments
		BulletTracerOffset1 = Vector3.new(-0.3, 0, 0); --NOTE: Bullet tracer size is depends on position between two attachments
		BulletSpeed = 4000; --Studs/second
		DropGravity = 0; --The amount of gravity applied to the bullet. Default place gravity is 196.2 (see workspace.Gravity)
		WindOffset = Vector3.new(0, 0, 0); --The amount of force applied to the bullet in world space. Useful for wind effects
		BulletSize = Vector3.new(0.4, 0.4, 0.4);
		BulletColor = Color3.fromRGB(245, 205, 48); --I used "Color3" instead of using "BrickColor"
		BulletTransparency = 1;
		BulletMaterial = Enum.Material.Neon;
        BulletShape = Enum.PartType.Block; --Block or Ball, or Cylinder?]]

        BulletMeshEnabled = false; --Create a custom mesh for the bullet when firing
        BulletMeshID = 437259501;
        BulletTextureID = 437259505;
        BulletMeshScale = Vector3.new(0.002, 0.002, 0.002);

        BulletLightEnabled = true;
        BulletLightBrightness = 4;
        BulletLightColor = Color3.fromRGB(255, 165, 153);
        BulletLightRange = 10;
        BulletLightShadows = true;
		
--	====================
--	CHARGED SHOT
--	Make a gun charging before firing. Useful for a gun like "Railgun" or "Laser Cannon"
--	====================
		
		ChargedShotEnabled = false;
		ChargingTime = 1;
		
--	====================
--	MINIGUN
--	Make a gun delay before/after firing
--	====================

		MinigunEnabled = false;
		DelayBeforeFiring = 1;
		DelayAfterFiring = 1;
		
--	====================
--	MISCELLANEOUS
--	Etc. settings for the gun
--	====================

		Knockback = 1; --Setting above 0 will enabling the gun to push enemy back.
		Lifesteal = 0; --In percent - Setting above 0 will allow user to steal enemy's health by dealing a damage to them.
		FlamingBullet = false; --Enable the bullet to set enemy on fire. Its DPS and Duration can be edited inside "IgniteScript"
		DualEnabled = false; --Enable the user to hold two guns instead one. In order to make this setting work, you must clone its Handle and name it to "Handle2". Enabling this setting will override Idle Animation ID.
		--Piercing = 0; --Setting above 0 will enabling the gun to penetrate up to XX victim(s). Cannot penetrate wall. NOTE: It doesn't work with "ExplosiveEnabled"
		
--	====================
--	END OF SETTING
--	====================
}

return Module]]></ProtectedString>
					<string name="ScriptGuid">{33C9AEE8-C477-4FFF-9080-970DE226E68C}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">18014364149484288</SecurityCapabilities>
					<bool name="DefinesCapabilities">true</bool>
					<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db7100001211</UniqueId>
					<string name="Name">ServerStorage_Setting</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1333d5215a2be5650b0775a300000f49</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBXBBDDFA99B49E484D94D1259B6EF8066E">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild('HumanoidRootPart')
local Camera = workspace.CurrentCamera
local RunService = game:GetService('RunService')
local UIS = game:GetService('UserInputService')

local Barrel = Tool:FindFirstChild('Barrel', true) or Tool:FindFirstChild('Handle')
local IsAimingValue = Tool:FindFirstChild('IsAiming') or Instance.new('BoolValue', Tool)
IsAimingValue.Name = 'IsAiming'

local function getAmmoValue()
	local inv = Player:FindFirstChild('AmmoInventory')
	return inv and (inv:FindFirstChild('5.56mm') or inv:FindFirstChild('556') or inv:FindFirstChild('Rifle'))
end

local MAX_BALAS = 30
local balasActuales = 30
local recargando = false
local mouseDown = false
local FIRE_RATE = 0.09 -- 700 RPM
local lastShot = 0

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild('PlayerGui')
	local gui = pGui and pGui:FindFirstChild('AmmoGui')
	if gui then
		gui.Enabled = visible
		if visible then
			local v = getAmmoValue()
			gui.Frame.AmmoText.Text = balasActuales .. ' / ' .. (v and v.Value or 0)
		end
	end
end

local function crearBolita()
	local barrelPos = Barrel and Barrel.Position or RootPart.Position + RootPart.CFrame.LookVector * 2
	local p = Instance.new('Part')
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.3, 0.3, 0.3)
	p.Color = Color3.fromRGB(255, 180, 20)
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.Position = barrelPos
	p.Parent = workspace
	return p
end

local function disparar()
	local now = tick()
	if recargando or (now - lastShot) < FIRE_RATE then return end
	lastShot = now

	if balasActuales <= 0 then
		Tool.DisparoEvent:FireServer(nil, 0, 'sonido_vacio')
		return
	end

	balasActuales -= 1
	actualizarGUI(true)
	Tool.DisparoEvent:FireServer(nil, 0, 'sonido_disparo')

	local proyectil = crearBolita()
	local direccion = Camera.CFrame.LookVector
	local distancia = 0

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		local paso = direccion * (600 * dt)
		local result = workspace:Raycast(proyectil.Position, paso, RaycastParams.new())
		if result then
			local model = result.Instance:FindFirstAncestorOfClass('Model')
			local hum = model and model:FindFirstChildOfClass('Humanoid')
			if hum then Tool.DisparoEvent:FireServer(hum, 22) end
			proyectil:Destroy(); conn:Disconnect()
		else
			proyectil.Position += paso
			distancia += paso.Magnitude
			if distancia > 400 then proyectil:Destroy(); conn:Disconnect() end
		end
	end)
end

local function recargar()
	local v = getAmmoValue()
	if recargando or (v and v.Value or 0) <= 0 or balasActuales == MAX_BALAS then return end
	recargando = true
	Tool.DisparoEvent:FireServer(nil, 0, 'sonido_recarga')
	task.wait(2.2)
	v = getAmmoValue()
	if v then
		local falta = MAX_BALAS - balasActuales
		local pris = math.min(falta, v.Value)
		v.Value -= pris
		balasActuales += pris
	end
	recargando = false
	actualizarGUI(true)
end

RunService.Heartbeat:Connect(function()
	if mouseDown and Tool.Parent == Character then disparar() end
end)

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = true
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = false end
end)

RunService.RenderStepped:Connect(function()
	if IsAimingValue.Value and RootPart and Tool.Parent == Character then
		local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
		RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, rot + math.pi, 0)
	end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() actualizarGUI(false); recargando = false; mouseDown = false end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{E2425981-5585-4C58-822F-A54EF312B9CF}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">25c709a2410230a90b07526600000f62</UniqueId>
					<string name="Name">ServerStorage_Disparo</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1333d5215a2be5650b0775a300000f4b</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX414D1AA3D9614B7A8B566C3D8B20FD22">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Remote = Tool:WaitForChild('DisparoEvent')
Remote.OnServerEvent:Connect(function(player, humanoid, danio, accion)
	local character = player.Character
	local barrel = character and character:FindFirstChild('Barrel', true) or (character and character:FindFirstChild('Handle', true))
	if accion == 'sonido_disparo' then
		local s = Tool:FindFirstChild('SonidoDisparo', true)
		if s and barrel then local c = s:Clone(); c.Parent = barrel; c:Play(); game:GetService('Debris'):AddItem(c, c.TimeLength + 1) end
		return
	end
	if accion == 'sonido_recarga' then
		local s = Tool:FindFirstChild('SonidoRecarga', true)
		if s and barrel then local c = s:Clone(); c.Parent = barrel; c:Play(); game:GetService('Debris'):AddItem(c, c.TimeLength + 1) end
		return
	end
	if accion == 'sonido_vacio' then return end
	if humanoid and humanoid:IsA('Humanoid') then humanoid:TakeDamage(danio or 22) end
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{5F436292-DBC6-424A-9BDB-37C443C83531}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">25c709a2410230a90b07526600000f64</UniqueId>
					<string name="Name">ServerStorage_Disparo_sv</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1333d5215a2be5650b0775a300000f4d</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXFA5B778BDC064303BB67B384E3013B04">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[ Edited Version
====================================================================================================
Weapons and Tools Pack 2016's Gun by SuperEvilAzmil and edited by thienbao2109

Features:
- FilteringEnabled support
- Easy to edit with a bunch of settings
- No delays between Mouse Click and Gun Fire
====================================================================================================
]]

local Module = {
--	====================
--	BASIC
--	A basic settings for the gun
--	====================

		Auto = true;
		BaseDamage = 17;
		FireRate = 0.205; --In second
		ReloadTime = 2.00; --In second
		EquippingTime = 0; --In second
		AmmoPerMag = 25; --Put "math.huge" to make this gun has infinite ammo and never reload
		SpreadX = 5; --In degree
		SpreadY = 1.5; --In degree
		Range = 5000; --The furthest distance the bullet can travel
		HeadshotEnabled = true; --Enable the gun to do extra damage on headshot
		HeadshotDamageMultiplier = 1.3;
	IdleAnimationID = 11268432475; --Set to "nil" if you don't want to animate
		IdleAnimationSpeed = 1;
	FireAnimationID = 11268591274; --Set to "nil" if you don't want to animate
		FireAnimationSpeed = 1;
	ReloadAnimationID = 11268894290; --Set to "nil" if you don't want to animate
		ReloadAnimationSpeed = 1;
	EquippedAnimationID = nil; --Set to "nil" if you don't want to animate
		EquippedAnimationSpeed = 1;
		
--	====================
--	WALK SPEED REDUTION
--	Nerf chraracter's walk speed when equip the gun
--	====================

        WalkSpeedRedutionEnabled = false;
        WalkSpeedRedution = 6;
		
--	====================
--	HOLD DOWN ANIMATION
--	Character won't fire if hold down the gun
--	====================

        HoldDownEnabled = true;
	HoldDownAnimationID = 11268950861;
        HoldDownAnimationSpeed = 1;
		
--	====================
--	BULLET HOLE VISUALIZER
--	Create a bullet hole when a bullet hit something but not character
--	====================

        BulletHoleEnabled = true;
        BulletHoleSize = 0.5;
        BulletHoleTexture = {2078626}; --You can insert more IDs
        BulletHoleVisibleTime = 3; --In second
        BulletHoleFadeTime = 1; --In second
        PartColor = true; --Set to hit object color
		
--	====================
--	HIT VISUALIZER
--	Create hit effect when a bullet hit something but not character(And hit sound, too)
--	====================

        HitEffectEnabled = true;
		HitSoundIDs = {186809061, 186809249, 186809250, 186809252};
		HitSoundPitch = math.random(90,110)/100; --I set it to "math.random" to makes it better. If you don't want it, then set it whatever you want(Default is 1)
		HitSoundVolume = 1;
        CustomHitEffect = false; --Emits your custom hit effect. NOTE: If you this setting disabled, hit effect will set to default(material tracker included)

--	====================
--	BLOOD VISUALIZER
--	Create blood when a bullet hit character(And hit character sound, too)
--	====================

        BloodEnabled = false;
		HitCharSndIDs = {245630921, 245630994, 245631056, 245631112, 245631167};
		HitCharSndPitch = 1; --Default is 1
		HitCharSndVolume = 1;
		FleshHole = true;
		FleshHoleSize = 0.5;
        FleshHoleTexture = {2078626}; --You can insert more IDs
        FleshHoleVisibleTime = 3; --In second
        FleshHoleFadeTime = 1; --In second
        FleshHoleColor = Color3.fromRGB(255, 0, 0);
		
--	====================
--	TWEEN SETTING
--	Part of ironsight and sniper aim
--	====================

        TweenLength = 0.8; --In second
        EasingStyle = Enum.EasingStyle.Quint; --Linear, Sine, Back, Quad, Quart, Quint, Bounce or Elastic?
        EasingDirection = Enum.EasingDirection.Out; --In, Out or InOut?

--	====================
--	TWEEN SETTING(NO AIM DOWN)
--	Part of ironsight and sniper aim
--	====================

        TweenLengthNAD = 0.8; --In second
        EasingStyleNAD = Enum.EasingStyle.Quint; --Linear, Sine, Back, Quad, Quart, Quint, Bounce or Elastic?
        EasingDirectionNAD = Enum.EasingDirection.Out; --In, Out or InOut?
		
--	====================
--	BULLET WHIZZING SOUND
--	Create a sound when a bullet travelling through character(or camera)
--	====================

        WhizSoundEnabled = true;
        WhizSoundID = {269514869, 269514887, 269514807, 269514817};
        WhizSoundVolume = 0.5;
        WhizSoundPitch = 1; --Default is 1
		
--	====================
--	HITMARKER
--	Mark on somewhere when a bullet hit character
--	====================

        HitmarkerEnabled = true;
        --Normal
        HitmarkerColor = Color3.fromRGB(255, 255, 255);
        HitmarkerFadeTime = 0.4;
        HitmarkerSoundPitch = 1;
        --Headshot
        HitmarkerColorHS = Color3.fromRGB(255, 0, 0);
        HitmarkerFadeTimeHS = 0.4;
        HitmarkerSoundPitchHS = 0.75;

--	====================
--	CROSSHAIR
--	A gun cursor
--	====================

        CrossSize = 7;
        CrossExpansion = 100;
        CrossSpeed = 15;
        CrossDamper	= 0.8;
		
--	====================
--	MUZZLE
--	Create a muzzle flash when firing
--	====================
        
        MuzzleFlashEnabled = true;
        MuzzleLightEnabled = true;
        LightBrightness = 4;
        LightColor = Color3.new(255/255, 283/255, 0/255);
        LightRange = 15;
        LightShadows = true;
        VisibleTime = 0.01; --In second
		
--	====================
--	BULLET SHELL EJECTION
--	Eject bullet shells when firing
--	====================

		BulletShellEnabled = true;
		BulletShellOffset = Vector3.new(0, 0.4, 0);
		ShellSize = Vector3.new(0.2, 0.2, 0.32); --Scale the part
		AllowCollide = false; --If false, a bullet shell will go through any parts
		ShellScale = Vector3.new(1.5, 1.5, 1.5); --Scale mesh
		ShellMeshID = 95392019;
		ShellTextureID = 95391833;
		DisappearTime = 5; --In second
		
--      You can edit velocity by go to GunScript_Local, and scroll down until you see "function EjectShell(ShootingHandle)"
		
--	====================
--	IRONSIGHT
--	Allow user to ironsighting
--	====================

		IronsightEnabled = true; --NOTE: If "SniperEnabled" is enabled, this setting is not work
		FieldOfViewIS = 50;
		MouseSensitiveIS = 0.2; --In percent
		SpreadRedutionIS = 0.6; --In percent. NOTE: Must be the same value as "SpreadRedutionS"
		CrossScaleIS = 0.6;
		
--	====================
--	LIMITED AMMO
--	Make a gun has a limit ammo
--	====================

		LimitedAmmoEnabled = true;
		Ammo = 360;
		MaxAmmo = 360; --Put "math.huge" to allow user to carry unlimited ammo
		
--	====================
--	SHOTGUN
--	Enable the gun to fire multiple bullet in one shot
--	====================

		ShotgunEnabled = false;
		BulletPerShot = 8;
		
		ShotgunReload = false; --Make user reloading like Shotgun, which user clipin shell one by one
		ShotgunClipinAnimationID = nil; --Set to "nil" if you don't want to animate
		ShotgunClipinAnimationSpeed = 1;
		ShellClipinSpeed = 0.5; --In second
		
--		How "ShotgunEnabled" work [Example]:

--		Play "ShotgunClipinAnimation" + Play "ShotgunClipin" Audio
--		>>>
--		Wait "ShellClipinSpeed" second
--		>>>
--		Repeat "AmmoPerClip" - "Current Ammo" times
--		>>>
--		Play "ReloadAnimation" + Play "ReloadSound"
--		Wait "ReloadTime"
		
--	====================
--	BURST FIRE
--	Enable the gun to do burst firing like Assault Rifle
--	====================

		BurstFireEnabled = false;
		BulletPerBurst = 3;
		BurstRate = 0.075; --In second
		
--	====================
--	SNIPER
--	Enable user to use scope
--	====================

		SniperEnabled = false; --NOTE: If "IronsightEnabled" is enabled, this setting is not work
		FieldOfViewS = 12.5;
		MouseSensitiveS = 0.2; --In percent
		SpreadRedutionS = 0.6; --In percent. NOTE: Must be the same value as "SpreadRedutionOS"
		CrossScaleS = 0;
		
--	====================
--	CAMERA RECOILING
--	Make user's camera recoiling when shooting
--	====================

		CameraRecoilingEnabled = true;
		Recoil = 6;
		AngleX_Min = 1; --In degree
		AngleX_Max = 1; --In degree
		AngleY_Min = 0; --In degree
		AngleY_Max = 0; --In degree
		AngleZ_Min = -1; --In degree
		AngleZ_Max = 1; --In degree
        Accuracy = 0.1; --In percent. For example: 0.5 is 50%
        RecoilSpeed = 10; 
        RecoilDamper = 0.35;
		RecoilRedution = 0.12; --In percent.
		
--	====================
--	EXPLOSIVE
--	Make a bullet explosive so user can deal a damage to multiple enemy in single shot. NOTE: Explosion won't break joints
--	====================

		ExplosiveEnabled = false;
		ExplosionSoundEnabled = true;
		ExplosionSoundIDs = {163064102};
		ExplosionSoundPitch = 1; --Default is 1
		ExplosionSoundVolume = 1;
		ExplosionRadius = 8;
		CustomExplosion = false;
		
--	====================
--	BULLET VISUALIZER
--	Enabled the gun to display a travelling bullet
--	====================

		BulletTracerEnabled = true; --Create a tracer for the bullet when firing
		BulletParticleEnaled = false; --Create a particle effect for bullet when firing
		BulletTracerOffset0 = Vector3.new(0.3, 0, 0); --NOTE: Bullet tracer size is depends on position between two attachments
		BulletTracerOffset1 = Vector3.new(-0.3, 0, 0); --NOTE: Bullet tracer size is depends on position between two attachments
		BulletSpeed = 4000; --Studs/second
		DropGravity = 0; --The amount of gravity applied to the bullet. Default place gravity is 196.2 (see workspace.Gravity)
		WindOffset = Vector3.new(0, 0, 0); --The amount of force applied to the bullet in world space. Useful for wind effects
		BulletSize = Vector3.new(0.4, 0.4, 0.4);
		BulletColor = Color3.fromRGB(245, 205, 48); --I used "Color3" instead of using "BrickColor"
		BulletTransparency = 1;
		BulletMaterial = Enum.Material.Neon;
        BulletShape = Enum.PartType.Block; --Block or Ball, or Cylinder?]]

        BulletMeshEnabled = false; --Create a custom mesh for the bullet when firing
        BulletMeshID = 437259501;
        BulletTextureID = 437259505;
        BulletMeshScale = Vector3.new(0.002, 0.002, 0.002);

        BulletLightEnabled = true;
        BulletLightBrightness = 4;
        BulletLightColor = Color3.fromRGB(255, 165, 153);
        BulletLightRange = 10;
        BulletLightShadows = true;
		
--	====================
--	CHARGED SHOT
--	Make a gun charging before firing. Useful for a gun like "Railgun" or "Laser Cannon"
--	====================
		
		ChargedShotEnabled = false;
		ChargingTime = 1;
		
--	====================
--	MINIGUN
--	Make a gun delay before/after firing
--	====================

		MinigunEnabled = false;
		DelayBeforeFiring = 1;
		DelayAfterFiring = 1;
		
--	====================
--	MISCELLANEOUS
--	Etc. settings for the gun
--	====================

		Knockback = 1; --Setting above 0 will enabling the gun to push enemy back.
		Lifesteal = 0; --In percent - Setting above 0 will allow user to steal enemy's health by dealing a damage to them.
		FlamingBullet = false; --Enable the bullet to set enemy on fire. Its DPS and Duration can be edited inside "IgniteScript"
		DualEnabled = false; --Enable the user to hold two guns instead one. In order to make this setting work, you must clone its Handle and name it to "Handle2". Enabling this setting will override Idle Animation ID.
		--Piercing = 0; --Setting above 0 will enabling the gun to penetrate up to XX victim(s). Cannot penetrate wall. NOTE: It doesn't work with "ExplosiveEnabled"
		
--	====================
--	END OF SETTING
--	====================
}

return Module]]></ProtectedString>
					<string name="ScriptGuid">{E34C1B50-9DBF-4D0E-AED4-6542E2544492}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
