			<Item class="LocalScript" referent="RBX4CB4D5414AEC4CE3A12EF2F648D0BEFF">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild('HumanoidRootPart')
local Camera = workspace.CurrentCamera
local RunService = game:GetService('RunService')
local UIS = game:GetService('UserInputService')

local Barrel = Tool:FindFirstChild('Barrel', true) or Tool:FindFirstChild('Handle')
local IsAimingValue = Tool:FindFirstChild('IsAiming') or Instance.new('BoolValue', Tool)
IsAimingValue.Name = 'IsAiming'

local function getAmmoValue()
	local inv = Player:FindFirstChild('AmmoInventory')
	return inv and (inv:FindFirstChild('5.56mm') or inv:FindFirstChild('556') or inv:FindFirstChild('Rifle'))
end

local MAX_BALAS = 30
local balasActuales = 30
local recargando = false
local mouseDown = false
local FIRE_RATE = 0.09 -- 700 RPM
local lastShot = 0

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild('PlayerGui')
	local gui = pGui and pGui:FindFirstChild('AmmoGui')
	if gui then
		gui.Enabled = visible
		if visible then
			local v = getAmmoValue()
			gui.Frame.AmmoText.Text = balasActuales .. ' / ' .. (v and v.Value or 0)
		end
	end
end

local function crearBolita()
	local barrelPos = Barrel and Barrel.Position or RootPart.Position + RootPart.CFrame.LookVector * 2
	local p = Instance.new('Part')
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.3, 0.3, 0.3)
	p.Color = Color3.fromRGB(255, 180, 20)
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.Position = barrelPos
	p.Parent = workspace
	return p
end

local function disparar()
	local now = tick()
	if recargando or (now - lastShot) < FIRE_RATE then return end
	lastShot = now

	if balasActuales <= 0 then
		Tool.DisparoEvent:FireServer(nil, 0, 'sonido_vacio')
		return
	end

	balasActuales -= 1
	actualizarGUI(true)
	Tool.DisparoEvent:FireServer(nil, 0, 'sonido_disparo')

	local proyectil = crearBolita()
	local direccion = Camera.CFrame.LookVector
	local distancia = 0

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		local paso = direccion * (600 * dt)
		local result = workspace:Raycast(proyectil.Position, paso, RaycastParams.new())
		if result then
			local model = result.Instance:FindFirstAncestorOfClass('Model')
			local hum = model and model:FindFirstChildOfClass('Humanoid')
			if hum then Tool.DisparoEvent:FireServer(hum, 22) end
			proyectil:Destroy(); conn:Disconnect()
		else
			proyectil.Position += paso
			distancia += paso.Magnitude
			if distancia > 400 then proyectil:Destroy(); conn:Disconnect() end
		end
	end)
end

local function recargar()
	local v = getAmmoValue()
	if recargando or (v and v.Value or 0) <= 0 or balasActuales == MAX_BALAS then return end
	recargando = true
	Tool.DisparoEvent:FireServer(nil, 0, 'sonido_recarga')
	task.wait(2.2)
	v = getAmmoValue()
	if v then
		local falta = MAX_BALAS - balasActuales
		local pris = math.min(falta, v.Value)
		v.Value -= pris
		balasActuales += pris
	end
	recargando = false
	actualizarGUI(true)
end

RunService.Heartbeat:Connect(function()
	if mouseDown and Tool.Parent == Character then disparar() end
end)

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = true
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = false end
end)

RunService.RenderStepped:Connect(function()
	if IsAimingValue.Value and RootPart and Tool.Parent == Character then
		local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
		RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, rot + math.pi, 0)
	end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() actualizarGUI(false); recargando = false; mouseDown = false end)
]]></ProtectedString>
