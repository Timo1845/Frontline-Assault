			<Item class="ModuleScript" referent="RBX59CE5723D4624888A024D7AB564DBE75">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[ Edited Version
====================================================================================================
