			<Item class="LocalScript" referent="RBXD4A6943DDC1540BE9365D11C42DF3DB2">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

-- Función para cambiar las colisiones
local function setToolCollisions(enabled)
	for _, part in pairs(Tool:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = enabled
			-- También desactivamos CanQuery para que la cámara no choque con el arma
			part.CanQuery = enabled 
		end
	end
end

Tool.Equipped:Connect(function()
	-- Desactivar colisiones al equipar
	setToolCollisions(false)
end)

Tool.Unequipped:Connect(function()
	-- Opcional: Reactivarlas al soltarla si la herramienta se queda en el suelo
	setToolCollisions(true)
end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
