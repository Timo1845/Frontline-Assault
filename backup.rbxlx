			<Item class="LocalScript" referent="RBX008A7AC8D08646EBAFE9E93D1D0CB1FA">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local IsAimingValue = Tool:WaitForChild("IsAiming")
local Barrel = Tool:FindFirstChild("Barrel", true)
local DisparoEvent = Tool:WaitForChild("DisparoEvent")

local MAX_BALAS = 5
local CALIBRE = ".30-06 Springfield"

local function getAmmoValue()
	local inv = Player:FindFirstChild("AmmoInventory")
	return inv and inv:FindFirstChild(CALIBRE)
end

local function getBalas() return Tool:GetAttribute("Balas") or MAX_BALAS end
local function setBalas(n) Tool:SetAttribute("Balas", n) end

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild("PlayerGui")
	local gui = pGui and pGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		local ammoVal = getAmmoValue()
		gui.Frame.AmmoText.Text = getBalas() .. " / " .. (ammoVal and ammoVal.Value or 0)
	end
end

local function disparar()
	local balas = getBalas()
	if balas <= 0 or Tool:GetAttribute("Recargando") or Tool:GetAttribute("BoltAction") then 
		if balas <= 0 then DisparoEvent:FireServer(nil, 0, "sonido_vacio") end
		return 
	end

	setBalas(balas - 1)
	actualizarGUI(true)
	DisparoEvent:FireServer(nil, 0, "sonido_disparo")

	-- Bala visual con Raycast
	local p = Instance.new("Part")
	p.Size = Vector3.new(0.4, 0.4, 0.4); p.Color = Color3.fromRGB(255, 200, 50); p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false; p.Position = Barrel.Position; p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 2)

	local dir = Camera.CFrame.LookVector
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local result = workspace:Raycast(p.Position, dir * (800 * dt), RaycastParams.new())
		if result then
			local hum = result.Instance:FindFirstAncestorOfClass("Model") and result.Instance.Parent:FindFirstChild("Humanoid")
			if hum then DisparoEvent:FireServer(hum, 90) end 
			p:Destroy(); connection:Disconnect()
		else
			p.Position += dir * (800 * dt)
		end
	end)

	-- MECÁNICA CERROJO (0.5s Cooldown)
	if getBalas() > 0 then
		Tool:SetAttribute("BoltAction", true)
		task.wait(0.1)
		DisparoEvent:FireServer(nil, 0, "sonido_cerrojo")

		local boltAnim = Tool:FindFirstChild("BoltAnim")
		if boltAnim then
			local track = Humanoid:LoadAnimation(boltAnim)
			track:Play()
		end
		task.wait(0.5) -- Cooldown de 0.5 segundos solicitado
		Tool:SetAttribute("BoltAction", false)
	end
end

local function recargar()
	local ammoVal = getAmmoValue()
	if not ammoVal or ammoVal.Value <= 0 or getBalas() == MAX_BALAS or Tool:GetAttribute("Recargando") then return end

	Tool:SetAttribute("Recargando", true)
	DisparoEvent:FireServer(nil, 0, "sonido_recarga")

	local anim = Tool:FindFirstChild("RecargarAnim")
	if anim then
		local rt = Humanoid:LoadAnimation(anim)
		rt.Priority = Enum.AnimationPriority.Action4
		rt:Play()
		rt.Stopped:Wait()
	end

	local falta = MAX_BALAS - getBalas()
	if ammoVal.Value >= falta then
		ammoVal.Value -= falta
		setBalas(MAX_BALAS)
	else
		setBalas(getBalas() + ammoVal.Value)
		ammoVal.Value = 0
	end

	Tool:SetAttribute("Recargando", false)
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparar()
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() 
	actualizarGUI(false)
	Tool:SetAttribute("BoltAction", false)
end)]]></ProtectedString>
