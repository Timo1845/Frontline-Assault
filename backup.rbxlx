-- Función para cambiar las colisiones
local function setToolCollisions(enabled)
	for _, part in pairs(Tool:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = enabled
			-- También desactivamos CanQuery para que la cámara no choque con el arma
