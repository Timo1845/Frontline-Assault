					<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db710000121c</UniqueId>
					<string name="Name">ReplicatedStorage_CoreTextureSystem</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
