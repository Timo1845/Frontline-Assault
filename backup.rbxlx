				<Item class="Script" referent="RBXDE703B2A401C4689A1E0500038B42DF7">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local pickup = script.Parent
local prompt = pickup:WaitForChild("ProximityPrompt")
local Sonido = pickup:WaitForChild("SonidoRecojer")

-- --- CONFIGURACIÓN DE ESTA CAJA ---
-- IMPORTANTE: Debe ser EXACTO al nombre creado en el servidor (ej: ".45 ACP")
local CALIBRE_ESTA_CAJA = ".30-06 Springfield" 
local CANTIDAD_BALAS = 20          

local function ocultarTodo()
	prompt.Enabled = false

	-- Si el "pickup" es un modelo, necesitamos ocultar la parte principal
	if pickup:IsA("BasePart") then 
		pickup.Transparency = 1 
		pickup.CanCollide = false 
	end

	-- Ocultar todos los hijos visuales
	for _, hijo in ipairs(pickup:GetDescendants()) do
		if hijo:IsA("BasePart") or hijo:IsA("Decal") then
			hijo.Transparency = 1
			if hijo:IsA("BasePart") then 
				hijo.CanCollide = false 
			end
		end
	end
end

prompt.Triggered:Connect(function(player)
	-- Buscamos la carpeta de inventario
	local inventory = player:FindFirstChild("AmmoInventory")

	if inventory then
		-- Buscamos el calibre específico
		local ammoValue = inventory:FindFirstChild(CALIBRE_ESTA_CAJA)

		if ammoValue then
			-- 1. Sumar la munición
			ammoValue.Value = ammoValue.Value + CANTIDAD_BALAS
			print("Munición entregada: " .. CALIBRE_ESTA_CAJA) -- Para debug en la consola

			-- 2. Sonido y Desaparición
			if Sonido then 
				Sonido:Play() 
			end

			ocultarTodo()

			-- 3. Esperar a que el sonido termine y borrar
			task.wait(3)
			pickup:Destroy()
		else
			warn("No se encontró el calibre: " .. CALIBRE_ESTA_CAJA .. " en el inventario.")
		end
	else
		warn("El jugador no tiene la carpeta AmmoInventory.")
	end
end)]]></ProtectedString>
