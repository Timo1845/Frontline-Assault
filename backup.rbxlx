		<Item class="Script" referent="RBXC71818D0CD8E4289AEC6333532AE296A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Server-authoritative team selection.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local changeTeamEvent = ReplicatedStorage:FindFirstChild("ChangeTeamEvent")
if not changeTeamEvent then
	changeTeamEvent = Instance.new("RemoteEvent")
	changeTeamEvent.Name = "ChangeTeamEvent"
	changeTeamEvent.Parent = ReplicatedStorage
end
if not changeTeamEvent:IsA("RemoteEvent") then
	warn("[ChangeTeamHandler] ChangeTeamEvent exists but is not a RemoteEvent.")
	return
end

local selectionResult = ReplicatedStorage:FindFirstChild("TeamSelectionResult")
if not selectionResult then
	selectionResult = Instance.new("RemoteEvent")
	selectionResult.Name = "TeamSelectionResult"
	selectionResult.Parent = ReplicatedStorage
end
if not selectionResult:IsA("RemoteEvent") then
	warn("[ChangeTeamHandler] TeamSelectionResult exists but is not a RemoteEvent.")
	return
end

local allowedTeams = {
	["Spec Ops"] = true,
	["OpFor"] = true,
}
local lastRequestAt = {}
local teamSpawns = {
	["Spec Ops"] = "Spawn_SpecOps",
	["OpFor"] = "Spawn_OpFor",
}

local function moveToTeamSpawn(player, character)
	local tacticalMap = workspace:FindFirstChild("TacticalMap")
	local spawns = tacticalMap and tacticalMap:FindFirstChild("Spawns")
	local spawn = spawns and spawns:FindFirstChild(teamSpawns[player.Team and player.Team.Name or ""])
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if spawn and root then
		character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
	end
end

changeTeamEvent.OnServerEvent:Connect(function(player, teamName)
	if typeof(teamName) ~= "string" or not allowedTeams[teamName] then
		return
	end

	local now = os.clock()
	if lastRequestAt[player] and now - lastRequestAt[player] < 1 then
		return
	end
	lastRequestAt[player] = now

	local team = Teams:FindFirstChild(teamName)
	local tacticalMap = workspace:FindFirstChild("TacticalMap")
	local spawns = tacticalMap and tacticalMap:FindFirstChild("Spawns")
	local spawnName = teamSpawns[teamName]
	local teamSpawn = spawns and spawnName and spawns:FindFirstChild(spawnName)
	if not team or not team:IsA("Team") or not teamSpawn or not teamSpawn:IsA("SpawnLocation") then
		selectionResult:FireClient(player, false, "Team or team spawn unavailable")
		return
	end

	player.Team = team
	player.TeamColor = team.TeamColor
	player.Neutral = false
	selectionResult:FireClient(player, true, team.Name)

	local connection
	connection = player.CharacterAdded:Connect(function(character)
		if connection then
			connection:Disconnect()
			connection = nil
		end
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and player.Parent then
			moveToTeamSpawn(player, character)
		end
	end)
	player:LoadCharacter()
end)

Players.PlayerRemoving:Connect(function(player)
	lastRequestAt[player] = nil
end)
]]></ProtectedString>
