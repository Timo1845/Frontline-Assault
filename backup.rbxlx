				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXAD7773F7D3EC45FE9B3C931F8283B380">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Configuration partagée du Battle Pass TacticalMap.
local Config = {
	DataStoreName = "BattlePassData_v1",
	MaxLevel = 30,
	XPPerLevel = 1000,
	XPPerKill = 100,
	PremiumGamePassId = 2075799759,
	LevelProductId = 3717254646,
	MaxLevelCompensationCoins = 500,
}

local FreeSkins = {
	[5] = { id = "Glock_Camo", name = "Glock Camo" },
	[15] = { id = "MP7A1_Cobalt", name = "MP7A1 Cobalt" },
	[25] = { id = "MK18_SpecOps", name = "MK-18 SpecOps" },
}

local PremiumSkins = {
	[1] = { id = "Glock_Rouge", name = "Glock Crimson" },
	[10] = { id = "Deagle_Neon", name = "Deagle Cyber Néon" },
	[20] = { id = "M4A1_Carbone", name = "M4A1 Carbone" },
	[30] = { id = "AK47_Or", name = "AK-47 Or Prestige" },
}

local Rewards = {}
for level = 1, Config.MaxLevel do
	local fifths = math.floor(level / 5)

	Rewards[level] = {
		free = {
			type = "coins",
			amount = 100 + 25 * fifths,
		},
		premium = {
			type = "coins",
			amount = 200 + 50 * fifths,
		},
	}

	local freeSkin = FreeSkins[level]
	if freeSkin then
		Rewards[level].free = {
			type = "skin",
			id = freeSkin.id,
			name = freeSkin.name,
		}
	end

	local premiumSkin = PremiumSkins[level]
	if premiumSkin then
		Rewards[level].premium = {
			type = "skin",
			id = premiumSkin.id,
			name = premiumSkin.name,
		}
	end
end

Config.Rewards = Rewards

return Config
]]></ProtectedString>
