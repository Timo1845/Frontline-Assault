			<Item class="Script" referent="RBX6C86142CAF1749149372E060F3EBE40C">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- BulletInventory Server Script
-- Fournit et gere les reserves de munitions pour toutes les armes du FPS

local Players = game:GetService("Players")

local STARTING_AMMO = {
	-- Noms de calibres officiels
	[".45 ACP"] = 120,
	["9x19mm"] = 150,
	[".50 AE"] = 70,
	["12 Gauge"] = 60,
	[".30-06 Springfield"] = 60,
	["7.92x57mm Mauser"] = 60,
	["5.56x45mm NATO"] = 180,
	["7.62x39mm"] = 180,

	-- Alias pratiques pour compatibilite totale
	["5.56mm"] = 180,
	["9mm"] = 150,
	["7.62mm"] = 180,
	["Rifle"] = 180,
	["SMG"] = 150,
	["Pistol"] = 150,
	["Shotgun"] = 60,
	["Sniper"] = 60,
}

local function setupPlayerAmmo(player)
	local ammoFolder = player:FindFirstChild("AmmoInventory")
	if not ammoFolder then
		ammoFolder = Instance.new("Folder")
		ammoFolder.Name = "AmmoInventory"
		ammoFolder.Parent = player
	end

	for calibre, defaultAmount in pairs(STARTING_AMMO) do
		local val = ammoFolder:FindFirstChild(calibre)
		if not val then
			val = Instance.new("IntValue")
			val.Name = calibre
			val.Value = defaultAmount
			val.Parent = ammoFolder
		elseif val.Value < defaultAmount / 3 then
			val.Value = defaultAmount
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	setupPlayerAmmo(player)
	player.CharacterAdded:Connect(function()
		setupPlayerAmmo(player)
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayerAmmo(player)
	player.CharacterAdded:Connect(function()
		setupPlayerAmmo(player)
	end)
end

print("[BulletInventory] Ammo system active with full caliber compatibility.")
]]></ProtectedString>
