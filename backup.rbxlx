			<Item class="Script" referent="RBX863428BE2204495DAFE5575054F3F77D">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Weapon Pickup System for Tactical FPS Map
-- Gives weapons to players when they interact with weapon stations

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local weaponsFolder = RS:FindFirstChild("Weapons")

if not weaponsFolder then
	warn("[WeaponPickup] Weapons folder not found in ReplicatedStorage!")
	return
end

-- Armes temporairement retirées de la distribution (modèles conservés).
local unavailableWeapons = {}

-- All available weapon names
local allWeapons = {}
for _, tool in ipairs(weaponsFolder:GetChildren()) do
	if tool:IsA("Tool") and not unavailableWeapons[tool.Name] then
		table.insert(allWeapons, tool.Name)
	end
end

-- Function to give a weapon to a player
local function giveWeapon(player, weaponName)
	if unavailableWeapons[weaponName] then return end
	local template = weaponsFolder:FindFirstChild(weaponName)
	if not template or not template:IsA("Tool") then return end

	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return end

	-- Check if player already has this weapon
	for _, item in ipairs(backpack:GetChildren()) do
		if item:IsA("Tool") and item.Name == weaponName then
			return -- Already has it
		end
	end

	-- Check character for equipped weapon
	local character = player.Character
	if character then
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") and item.Name == weaponName then
				return -- Already has it equipped
			end
		end
	end

	local clone = template:Clone()
	clone.Parent = backpack
end

-- Function to give all weapons from a station
local function giveStationWeapons(player, station)
	local count = 0
	for _, child in ipairs(station:GetChildren()) do
		if child:IsA("Tool") then
			giveWeapon(player, child.Name)
			count = count + 1
		end
	end
	return count
end

-- Set up proximity prompts on all weapon stations
local mapFolder = workspace:FindFirstChild("TacticalMap")
if mapFolder then
	local stations = mapFolder:FindFirstChild("WeaponStations")
	if stations then
		for _, station in ipairs(stations:GetChildren()) do
			local pedestal = station:FindFirstChild("Pedestal")
			if pedestal then
				local prompt = pedestal:FindFirstChildOfClass("ProximityPrompt")
				if prompt then
					prompt.Triggered:Connect(function(player)
						local count = giveStationWeapons(player, station)
					end)
				end
			end
		end
	end
end

-- Also give a default weapon on spawn so players are never unarmed
local function onCharacterAdded(player, character)
	task.wait(0.5)
	-- Give a default pistol
	giveWeapon(player, "Glock")
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	-- Handle already-existing character
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
end)

-- Handle players already in game
for _, player in ipairs(Players:GetPlayers()) do
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
end

print("[WeaponPickup] System ready. " .. #allWeapons .. " weapons available: " .. table.concat(allWeapons, ", "))
]]></ProtectedString>
