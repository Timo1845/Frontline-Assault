			<Item class="Script" referent="RBXDE771C0CD82A46E681FBC2F74262AC93">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Remote = Tool:WaitForChild("DisparoEvent")

local function play3D(nombre, barrel)
	if not barrel then return end
	local sonido = barrel:FindFirstChild(nombre)
	if not sonido then return end

	local s = sonido:Clone()
	s.Parent = barrel
	s:Play()
	game:GetService("Debris"):AddItem(s, s.TimeLength + 1)
end

Remote.OnServerEvent:Connect(function(player, humanoid, danio, accion)
	local char = player.Character
	local barrel = char and char:FindFirstChild("Barrel", true)

	if accion == "sonido_disparo" then play3D("SonidoDisparo", barrel)
	elseif accion == "sonido_recarga" then play3D("SonidoRecarga", barrel)
	elseif accion == "sonido_vacio" then play3D("SonidoVacio", barrel)
	elseif humanoid and humanoid:IsA("Humanoid") then
		humanoid:TakeDamage(danio)
	end
end)]]></ProtectedString>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
