				<Item class="LocalScript" referent="RBXC79DB59BC24C412CB54F8B38E0C5825E">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local IsAimingValue = Tool:WaitForChild("IsAiming")
local Barrel = Tool:FindFirstChild("Barrel", true)
local DisparoEvent = Tool:WaitForChild("DisparoEvent")

local MAX_BALAS = 5
local CALIBRE = "7.92x57mm Mauser"

local function getAmmoValue()
	local inv = Player:FindFirstChild("AmmoInventory")
	return inv and inv:FindFirstChild(CALIBRE)
end

local function getBalas() return Tool:GetAttribute("Balas") or MAX_BALAS end
local function setBalas(n) Tool:SetAttribute("Balas", n) end

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild("PlayerGui")
	local gui = pGui and pGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		local ammoVal = getAmmoValue()
		gui.Frame.AmmoText.Text = getBalas() .. " / " .. (ammoVal and ammoVal.Value or 0)
	end
end

local function disparar()
	local balas = getBalas()
	if balas <= 0 or Tool:GetAttribute("Recargando") or Tool:GetAttribute("BoltAction") then 
		if balas <= 0 then DisparoEvent:FireServer(nil, 0, "sonido_vacio") end
		return 
	end

	setBalas(balas - 1)
	actualizarGUI(true)
	DisparoEvent:FireServer(nil, 0, "sonido_disparo")

	-- Bala visual con Raycast
	local p = Instance.new("Part")
	p.Size = Vector3.new(0.4, 0.4, 0.4); p.Color = Color3.fromRGB(255, 200, 50); p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false; p.Position = Barrel.Position; p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 2)

	local dir = Camera.CFrame.LookVector
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local result = workspace:Raycast(p.Position, dir * (800 * dt), RaycastParams.new())
		if result then
			local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
			if hum then DisparoEvent:FireServer(hum, 90) end 
			p:Destroy(); connection:Disconnect()
		else
			p.Position += dir * (800 * dt)
		end
	end)

	-- MECÁNICA CERROJO (0.5s Cooldown)
	if getBalas() > 0 then
		Tool:SetAttribute("BoltAction", true)
		task.wait(0.1)
		DisparoEvent:FireServer(nil, 0, "sonido_cerrojo")

		local boltAnim = Tool:FindFirstChild("BoltAnim")
		if boltAnim then
			local track = Humanoid:LoadAnimation(boltAnim)
			track:Play()
		end
		task.wait(0.5) -- Cooldown de 0.5 segundos solicitado
		Tool:SetAttribute("BoltAction", false)
	end
end

local function recargar()
	local ammoVal = getAmmoValue()
	if not ammoVal or ammoVal.Value <= 0 or getBalas() == MAX_BALAS or Tool:GetAttribute("Recargando") then return end

	Tool:SetAttribute("Recargando", true)
	DisparoEvent:FireServer(nil, 0, "sonido_recarga")

	local anim = Tool:FindFirstChild("RecargarAnim")
	if anim then
		local rt = Humanoid:LoadAnimation(anim)
		rt.Priority = Enum.AnimationPriority.Action4
		rt:Play()
		rt.Stopped:Wait()
	end

	local falta = MAX_BALAS - getBalas()
	if ammoVal.Value >= falta then
		ammoVal.Value -= falta
		setBalas(MAX_BALAS)
	else
		setBalas(getBalas() + ammoVal.Value)
		ammoVal.Value = 0
	end

	Tool:SetAttribute("Recargando", false)
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparar()
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

Tool.Equipped:Connect(function() actualizarGUI(true) end)
Tool.Unequipped:Connect(function() 
	actualizarGUI(false)
	Tool:SetAttribute("BoltAction", false)
end)]]></ProtectedString>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<token name="RunContext">0</token>
						<string name="ScriptGuid">{F4289D48-A872-45DE-B07E-55106DD960CE}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">18014364149484288</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db7100000e48</UniqueId>
						<string name="Name">Disparo</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">2dd09ce98d5a46e90ad7db7100001e69</UniqueId>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX3B82B75C5B674155AD5CFE4713ED82E7">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local IsAimingValue = Tool:FindFirstChild("IsAiming") or Instance.new("BoolValue", Tool)
IsAimingValue.Name = "IsAiming"

local TrackEquip, TrackApuntar
local AIM_OFFSET = Vector3.new(1.5, 0.4, 0)

local function detenerTodo()
	IsAimingValue.Value = false
	-- Detener absolutamente todas las animaciones del humanoide relacionadas con la Tool
	for _, track in pairs(Humanoid:GetPlayingAnimationTracks()) do
		if track.Animation.Name == "EquipAnim" or track.Animation.Name == "Apuntar" or track.Animation.Name == "BoltAnim" then
			track:Stop(0)
		end
	end
	-- Resetear cámara y controles
	TweenService:Create(Camera, TweenInfo.new(0.2), {FieldOfView = 70}):Play()
	TweenService:Create(Humanoid, TweenInfo.new(0.2), {CameraOffset = Vector3.new(0,0,0)}):Play()
	UIS.MouseBehavior = Enum.MouseBehavior.Default
	Humanoid.AutoRotate = true
end

local function setAim(aiming)
	IsAimingValue.Value = aiming
	local targetFov = aiming and 40 or 70
	TweenService:Create(Camera, TweenInfo.new(0.2), {FieldOfView = targetFov}):Play()

	if aiming then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
		Humanoid.AutoRotate = false
		if TrackEquip then TrackEquip:Stop(0.1) end
		if TrackApuntar then TrackApuntar:Play(0.1) end
	else
		TweenService:Create(Humanoid, TweenInfo.new(0.2), {CameraOffset = Vector3.new(0,0,0)}):Play()
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		Humanoid.AutoRotate = true
		if TrackApuntar then TrackApuntar:Stop(0.1) end
		if TrackEquip and Tool.Parent == Character then TrackEquip:Play(0.1) end
	end
end

RunService.RenderStepped:Connect(function()
	if Tool.Parent ~= Character or not IsAimingValue.Value then return end

	local isFP = (Camera.CFrame.Position - Character.Head.Position).Magnitude < 1
	local targetOffset = isFP and Vector3.new(0,0,0) or AIM_OFFSET
	Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(targetOffset, 0.2)

	local root = Character:FindFirstChild("HumanoidRootPart")
	if root then
		local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, rot + math.pi, 0)
	end
end)

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then setAim(true) end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then setAim(false) end
end)

Tool.Equipped:Connect(function()
	TrackEquip = Humanoid:LoadAnimation(Tool:WaitForChild("EquipAnim"))
	TrackApuntar = Humanoid:LoadAnimation(Tool:WaitForChild("Apuntar"))
	TrackEquip.Priority = Enum.AnimationPriority.Action2
	TrackApuntar.Priority = Enum.AnimationPriority.Action4
	TrackEquip:Play(0.1)
end)

Tool.Unequipped:Connect(detenerTodo)]]></ProtectedString>
