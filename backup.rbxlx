					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db71000005c4</UniqueId>
					<string name="Name">ServerScriptService_Targets</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
