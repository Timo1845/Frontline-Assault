				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Team selection client: requests are validated and applied by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local gui = script.Parent.Parent
local frame = script.Parent
local buttonSpecOps = frame:FindFirstChild("BoutonSpecOps")
local buttonOpFor = frame:FindFirstChild("BoutonOpFor")
local changeTeamEvent = ReplicatedStorage:WaitForChild("ChangeTeamEvent", 10)
local selectionResult = ReplicatedStorage:WaitForChild("TeamSelectionResult", 10)
local requestPending = false

local function requestTeam(teamName)
	if requestPending or not changeTeamEvent or not changeTeamEvent:IsA("RemoteEvent") then
		return
	end
	requestPending = true
	changeTeamEvent:FireServer(teamName)
	task.delay(8, function()
		if requestPending then
			requestPending = false
			gui.Enabled = true
		end
	end)
end

if buttonSpecOps and buttonSpecOps:IsA("TextButton") then
	buttonSpecOps.MouseButton1Click:Connect(function()
		requestTeam("Spec Ops")
	end)
end

if buttonOpFor and buttonOpFor:IsA("TextButton") then
	buttonOpFor.MouseButton1Click:Connect(function()
		requestTeam("OpFor")
	end)
end

-- Keep the picker visible until the server accepts a team and respawns the player.
gui.Enabled = true
if selectionResult and selectionResult:IsA("RemoteEvent") then
	selectionResult.OnClientEvent:Connect(function(success)
		requestPending = false
		if success then
			gui.Enabled = false
		else
			gui.Enabled = true
		end
	end)
end

player.CharacterAdded:Connect(function()
	if player.Team == nil then
		gui.Enabled = true
	end
end)
]]></ProtectedString>
