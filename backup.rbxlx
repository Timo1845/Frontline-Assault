			<Item class="Script" referent="RBX6A7C547741A449388D602A353FB8B562">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Remote = Tool:WaitForChild("DisparoEvent")

-- Sonidos que ya tienes dentro del arma
local sonidoDisparo = Tool:FindFirstChild("SonidoDisparo")
local sonidoVacio = Tool:FindFirstChild("SonidoVacio") 

-- Si no tienes el sonido "SonidoVacio" creado, este bloque lo crea por ti:
if not sonidoVacio then
	sonidoVacio = Instance.new("Sound")
	sonidoVacio.Name = "SonidoVacio"
	sonidoVacio.SoundId = "rbxassetid://116664883827057" -- Sonido de clic universal
	sonidoVacio.Volume = 0.6
	sonidoVacio.Parent = Tool:WaitForChild("Handle")
end

Remote.OnServerEvent:Connect(function(player, targetHum, damage)
	-- Verificamos si es un disparo real o un intento sin balas
	if damage and damage > 0 then
		-- Es un disparo con balas
		if sonidoDisparo then sonidoDisparo:Play() end

		-- Aplicar damage si hay un objetivo
		if targetHum then
			targetHum:TakeDamage(damage)
		end
	else
		-- Es un intento de disparo con 0 balas
		if sonidoVacio then sonidoVacio:Play() end
	end
end)]]></ProtectedString>
