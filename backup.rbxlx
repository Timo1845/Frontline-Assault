			<Item class="LocalScript" referent="RBX7B659029FEDE497ABFB5B8208B052459">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local IsAimingValue = Tool:WaitForChild("IsAiming")
local Barrel = Tool:FindFirstChild("Barrel", true)
local DisparoEvent = Tool:WaitForChild("DisparoEvent")

local MAX_BALAS = 8

-- Carga segura de munición
local function getAmmoValue()
	local inv = Player:FindFirstChild("AmmoInventory")
	return inv and inv:FindFirstChild(".30-06 Springfield")
end

local function getBalas() return Tool:GetAttribute("Balas") or MAX_BALAS end
local function setBalas(n) Tool:SetAttribute("Balas", n) end

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild("PlayerGui")
	local gui = pGui and pGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		local ammoVal = getAmmoValue()
		local reserva = ammoVal and ammoVal.Value or 0
		gui.Frame.AmmoText.Text = getBalas() .. " / " .. reserva
	end
end

local function disparar()
	local balas = getBalas()

	-- SONIDO DE VACÍO GLOBAL (Si intenta disparar sin balas)
	if balas <= 0 then
		if DisparoEvent then DisparoEvent:FireServer(nil, 0, "sonido_vacio") end
		return 
	end

	if not Barrel or Tool:GetAttribute("Recargando") then return end

	balas -= 1
	setBalas(balas)
	actualizarGUI(true)

	-- Sonido de Disparo Global
	if DisparoEvent then DisparoEvent:FireServer(nil, 0, "sonido_disparo") end

	-- Sonido de "Ping" metálico al vaciar el peine (8va bala)
	if balas == 0 then
		if DisparoEvent then DisparoEvent:FireServer(nil, 0, "sonido_ping") end
	end

	-- Bala visual
	local p = Instance.new("Part")
	p.Size = Vector3.new(0.4, 0.4, 0.4)
	p.Color = Color3.fromRGB(255, 200, 50)
	p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false
	p.Position = Barrel.Position
	p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 2)

	local dir = Camera.CFrame.LookVector
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local result = workspace:Raycast(p.Position, dir * (650 * dt), RaycastParams.new())
		if result then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChild("Humanoid")
			if hum then 
				if DisparoEvent then DisparoEvent:FireServer(hum, 65) end 
			end
			p:Destroy(); connection:Disconnect()
		else
			p.Position += dir * (650 * dt)
		end
	end)
end

local function recargar()
	local ammoVal = getAmmoValue()
	local balas = getBalas()
	if not ammoVal or ammoVal.Value <= 0 or balas > 0 or Tool:GetAttribute("Recargando") then return end

	Tool:SetAttribute("Recargando", true)

	-- Sonido de Recarga Global
	if DisparoEvent then DisparoEvent:FireServer(nil, 0, "sonido_recarga") end

	local anim = Tool:FindFirstChild("RecargarAnim")
	if anim then
		local rt = Humanoid:LoadAnimation(anim)
		rt.Priority = Enum.AnimationPriority.Action4
		rt:Play()
		rt.Stopped:Wait()
	end

	local falta = MAX_BALAS - balas
	if ammoVal.Value >= falta then
		ammoVal.Value -= falta
		setBalas(MAX_BALAS)
	else
		setBalas(balas + ammoVal.Value)
		ammoVal.Value = 0
	end

	Tool:SetAttribute("Recargando", false)
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparar()
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

RunService.RenderStepped:Connect(function()
	if Tool.Parent ~= Character or not RootPart then return end

	-- Solo mantenemos la rotación del cuerpo al apuntar, sin mover la cámara
	if IsAimingValue.Value then
		local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
		RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, rot + math.pi, 0)
	end
end)

Tool.Equipped:Connect(function() 
	actualizarGUI(true)
	local ammoVal = getAmmoValue()
	if ammoVal then 
		ammoVal.Changed:Connect(function() 
			if Tool.Parent == Character then actualizarGUI(true) end 
		end) 
	end
end)

Tool.Unequipped:Connect(function() 
	actualizarGUI(false) 
end)]]></ProtectedString>
