			<Item class="LocalScript" referent="RBX937A6902ACFB47C3B775C62A98A3FFF5">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local IsAimingValue = Tool:WaitForChild("IsAiming")
local TrackEquip, TrackApuntar

local AIM_OFFSET = Vector3.new(1.5, 0.4, 0) 

-- Función para detener una animación de forma segura
local function stopTrack(track)
	if track and track.IsPlaying then
		track:Stop(0.1)
	end
end

local function setAim(aiming)
	IsAimingValue.Value = aiming

	local targetFov = aiming and 40 or 70
	TweenService:Create(Camera, TweenInfo.new(0.2), {FieldOfView = targetFov}):Play()

	if aiming then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
		Humanoid.AutoRotate = false

		stopTrack(TrackEquip) -- Detenemos la base
		if TrackApuntar then 
			TrackApuntar:Play(0.1) 
		end
	else
		-- Resetear cámara
		TweenService:Create(Humanoid, TweenInfo.new(0.2), {CameraOffset = Vector3.new(0,0,0)}):Play()
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		Humanoid.AutoRotate = true

		stopTrack(TrackApuntar) -- Detenemos apuntar

		-- FORZAR REINICIO: Esperamos un instante mínimo para que Roblox limpie la animación anterior
		task.defer(function()
			if Tool.Parent == Character and TrackEquip then
				TrackEquip:Stop(0) -- Aseguramos que esté muerta
				TrackEquip:Play(0.1) -- La revivimos
			end
		end)
	end
end

RunService.RenderStepped:Connect(function()
	if Tool.Parent ~= Character then return end

	local isFP = (Camera.CFrame.Position - Character.Head.Position).Magnitude < 1.2

	if IsAimingValue.Value then
		local targetOffset = isFP and Vector3.new(0,0,0) or AIM_OFFSET
		Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(targetOffset, 0.2)

		local root = Character:FindFirstChild("HumanoidRootPart")
		if root then
			local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
			root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, rot + math.pi, 0)
		end
	else
		if Humanoid.CameraOffset.Magnitude > 0.01 then
			Humanoid.CameraOffset = Humanoid.CameraOffset:Lerp(Vector3.new(0,0,0), 0.2)
		end
	end
end)

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then setAim(true) end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then setAim(false) end
end)

Tool.Equipped:Connect(function()
	-- Cargamos las animaciones
	TrackEquip = Humanoid:LoadAnimation(Tool:WaitForChild("EquipAnim"))
	TrackApuntar = Humanoid:LoadAnimation(Tool:WaitForChild("Apuntar"))

	TrackEquip.Priority = Enum.AnimationPriority.Action2
	TrackApuntar.Priority = Enum.AnimationPriority.Action4

	TrackEquip:Play(0.1)
end)

Tool.Unequipped:Connect(function()
	setAim(false)
	stopTrack(TrackEquip)
	stopTrack(TrackApuntar)
end)]]></ProtectedString>
