			<Item class="LocalScript" referent="RBX1C3E898FF5774040A2379774C8E5E379">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local IsAimingValue = Tool:WaitForChild("IsAiming")
local Barrel = Tool:FindFirstChild("Barrel", true)
local function getAmmoValue()
	local inv = Player:FindFirstChild("AmmoInventory")
	return inv and inv:FindFirstChild("12 Gauge")
end
local DisparoEvent = Tool:WaitForChild("DisparoEvent")

-- CONFIGURACIÓN REMINGTON
local MAX_BALAS = 5
local PERDIGONES = 8
local DISPERSION = 0.12
local VELOCIDAD_RECARGA = 0.3 

local function getBalas() return Tool:GetAttribute("Balas") or MAX_BALAS end
local function setBalas(n) Tool:SetAttribute("Balas", n) end

local function actualizarGUI(visible)
	local pGui = Player:FindFirstChild("PlayerGui")
	local gui = pGui and pGui:FindFirstChild("AmmoGui")
	if gui then 
		gui.Enabled = visible
		gui.Frame.AmmoText.Text = getBalas() .. " / " .. (getAmmoValue() and getAmmoValue().Value or 0)
	end
end

local function crearPerdigon()
	local p = Instance.new("Part")
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Color = Color3.fromRGB(255, 200, 50)
	p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false
	p.Position = Barrel.Position
	p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 1)

	local spread = Vector3.new((math.random()-0.5)*DISPERSION, (math.random()-0.5)*DISPERSION, (math.random()-0.5)*DISPERSION)
	local dir = (Camera.CFrame.LookVector + spread).Unit

	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local paso = dir * (500 * dt)
		local result = workspace:Raycast(p.Position, paso, RaycastParams.new())
		if result then
			local model = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChild("Humanoid")
			if hum then DisparoEvent:FireServer(hum, 15) end
			p:Destroy(); connection:Disconnect()
		else
			p.Position += paso
		end
	end)
end

local function disparar()
	if Tool:GetAttribute("Recargando") or Tool:GetAttribute("Accionando") or not Barrel then return end

	-- Lógica de Sin Balas
	if getBalas() <= 0 then
		DisparoEvent:FireServer(nil, 0, "sonido_vacio")
		return 
	end

	Tool:SetAttribute("Accionando", true) 
	setBalas(getBalas() - 1)
	actualizarGUI(true)

	-- Sonido de Disparo Global
	DisparoEvent:FireServer(nil, 0, "sonido_disparo")

	for i = 1, PERDIGONES do crearPerdigon() end

	task.wait(0.25) 

	-- Sonido de Pump Global (para que todos escuchen la corredera)
	DisparoEvent:FireServer(nil, 0, "sonido_pump")
	task.wait(0.25) 

	Tool:SetAttribute("Accionando", false) 
end

local function recargar()
	if Tool:GetAttribute("Recargando") or Tool:GetAttribute("Accionando") or (getAmmoValue() and getAmmoValue().Value or 0) <= 0 or getBalas() >= MAX_BALAS then return end

	Tool:SetAttribute("Recargando", true)

	while getBalas() < MAX_BALAS and (getAmmoValue() and getAmmoValue().Value or 0) > 0 do
		local anim = Tool:FindFirstChild("RecargarAnim")
		local rt
		if anim then
			rt = Humanoid:LoadAnimation(anim)
			rt.Priority = Enum.AnimationPriority.Action4
			rt:Play(0, 1, 1.5)
		end

		-- Sonido de Recarga Global
		DisparoEvent:FireServer(nil, 0, "sonido_recarga")

		task.wait(VELOCIDAD_RECARGA) 

		local aObj = getAmmoValue()
		if aObj then aObj.Value -= 1 end
		setBalas(getBalas() + 1)
		actualizarGUI(true)

		if rt then rt:Stop() end 
	end

	Tool:SetAttribute("Recargando", false)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparar()
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

Tool.Equipped:Connect(function() 
	actualizarGUI(true)
	Tool:SetAttribute("Recargando", false)
	Tool:SetAttribute("Accionando", false)
end)

Tool.Unequipped:Connect(function() 
	actualizarGUI(false) 
	Tool:SetAttribute("Recargando", false)
	Tool:SetAttribute("Accionando", false)
end)

MiMunicion.Changed:Connect(function() if Tool.Parent == Character then actualizarGUI(true) end end)]]></ProtectedString>
