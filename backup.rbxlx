				<Item class="Script" referent="RBX55E3F1209E194694953EAC115ADE5A62">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Remote = Tool:WaitForChild("DisparoEvent")

local function play3D(nombre, barrel)
	if not barrel then return end
	local sonido = Tool:FindFirstChild(nombre)
	if not sonido then return end

	local s = sonido:Clone()
	s.Parent = barrel
	s:Play()

	game:GetService("Debris"):AddItem(s, s.TimeLength + 1)
end

Remote.OnServerEvent:Connect(function(player, humanoid, danio, accion)

	local char = player.Character
	local barrel = char and char:FindFirstChild("Barrel", true)

	if accion == "sonido_disparo" then
		play3D("SonidoDisparo", barrel)
		return
	end

	if accion == "sonido_recarga" then
		play3D("SonidoRecarga", barrel)
		return
	end

	if accion == "sonido_ping" then
		play3D("SonidoPing", barrel)
		return
	end

	if humanoid and humanoid:IsA("Humanoid") then
		humanoid:TakeDamage(danio)
	end
end)]]></ProtectedString>
