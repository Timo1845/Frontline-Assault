			<Item class="Script" referent="RBX3BFD641DFB1F4B3481132E6BF4CF3647">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Team Setup for Tactical FPS Map
-- Creates two teams: SpecOps (Bright blue) and OpFor (Bright red)

local Teams = game:GetService("Teams")
local Players = game:GetService("Players")

-- Remove existing teams
for _, team in ipairs(Teams:GetTeams()) do
	team:Destroy()
end

-- Create SpecOps team (Bright blue)
local specOpsTeam = Instance.new("Team")
specOpsTeam.Name = "Spec Ops"
specOpsTeam.TeamColor = BrickColor.new("Bright blue")
specOpsTeam.AutoAssignable = false
specOpsTeam.Parent = Teams

-- Create OpFor team (Bright red)
local opForTeam = Instance.new("Team")
opForTeam.Name = "OpFor"
opForTeam.TeamColor = BrickColor.new("Bright red")
opForTeam.AutoAssignable = false
opForTeam.Parent = Teams

-- Players start neutral in the selection room. Choosing a team is handled by
-- ChangeTeamHandler; this script routes character spawns to the lobby or team spawn.
local function getCharacterDestination(player)
	local tacticalMap = workspace:FindFirstChild("TacticalMap")
	if not tacticalMap then return nil end

	if player.Team and player.Team.Name == "Spec Ops" then
		local spawns = tacticalMap:FindFirstChild("Spawns")
		return spawns and spawns:FindFirstChild("Spawn_SpecOps")
	elseif player.Team and player.Team.Name == "OpFor" then
		local spawns = tacticalMap:FindFirstChild("Spawns")
		return spawns and spawns:FindFirstChild("Spawn_OpFor")
	end

	local room = workspace:FindFirstChild("TeamSelectionRoom")
	return room and room:FindFirstChild("SelectionSpawn")
end

local function routeCharacter(player, character)
	local destination = getCharacterDestination(player)
	if not destination then return end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and player.Parent and character.Parent then
		character:PivotTo(destination.CFrame + Vector3.new(0, 4, 0))
	end
end

local function preparePlayer(player)
	player.Neutral = true
	player.Team = nil
	player.TeamColor = BrickColor.new("Medium stone grey")
	player.CharacterAdded:Connect(function(character)
		routeCharacter(player, character)
	end)
	if player.Character then
		task.defer(routeCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(preparePlayer)
for _, player in ipairs(Players:GetPlayers()) do
	preparePlayer(player)
end

print("[TacticalMap] Teams created: Spec Ops and OpFor; players choose in the selection room")
]]></ProtectedString>
