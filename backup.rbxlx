				<Item class="LocalScript" referent="RBX195A9FAB5A55444C96DE10D02F310B52">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local IsAimingValue = Tool:WaitForChild("IsAiming")
local Barrel = Tool:FindFirstChild("Barrel", true)

-- CONFIGURACIÓN M1911
local CALIBRE = ".45 ACP"
local MAX_BALAS = 7
local balasActuales = 7
local recargando = false

local function obtenerReserva()
	local inventory = Player:FindFirstChild("AmmoInventory")
	local ammoVal = inventory and inventory:FindFirstChild(CALIBRE)
	return ammoVal
end

local function actualizarGUI(visible)
	local AmmoGui = Player.PlayerGui:FindFirstChild("AmmoGui")
	if AmmoGui then 
		AmmoGui.Enabled = visible
		local ammoVal = obtenerReserva()
		local reserva = ammoVal and ammoVal.Value or 0
		AmmoGui.Frame.AmmoText.Text = balasActuales .. " / " .. reserva
	end
end

local function disparar()
	if recargando or balasActuales <= 0 or not Barrel then return end
	balasActuales -= 1
	actualizarGUI(true)

	local ev = Tool:FindFirstChild("DisparoEvent")
	if ev then ev:FireServer(nil, 0, "sonido_disparo") end

	local p = Instance.new("Part")
	p.Size = Vector3.new(0.3, 0.3, 0.3)
	p.Color = Color3.fromRGB(255, 150, 0)
	p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide = true, false
	p.Position = Barrel.Position
	p.Parent = workspace
	game:GetService("Debris"):AddItem(p, 2)

	local dir = Camera.CFrame.LookVector
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		local paso = dir * (500 * dt)
		local result = workspace:Raycast(p.Position, paso, RaycastParams.new())
		if result then
			local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
			local hum = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
			if hum then 
				local ev = Tool:FindFirstChild("DisparoEvent")
				if ev then ev:FireServer(hum, 35) end
			end
			p:Destroy(); connection:Disconnect()
		else
			p.Position += paso
		end
	end)
end

local function recargar()
	local ammoVal = obtenerReserva()
	-- VALIDACIÓN: Si no hay balas en reserva o el cargador está lleno, CANCELAR
	if recargando or not ammoVal or ammoVal.Value <= 0 or balasActuales == MAX_BALAS then 
		return 
	end

	recargando = true
	local ev = Tool:FindFirstChild("DisparoEvent")
	if ev then ev:FireServer(nil, 0, "sonido_recarga") end

	local rt = Humanoid:LoadAnimation(Tool:WaitForChild("RecargarAnim"))
	rt.Priority = Enum.AnimationPriority.Action4
	rt:Play()
	rt.Stopped:Wait()

	-- Lógica de traspaso
	local falta = MAX_BALAS - balasActuales
	if ammoVal.Value >= falta then
		ammoVal.Value -= falta
		balasActuales = MAX_BALAS
	else
		balasActuales += ammoVal.Value
		ammoVal.Value = 0
	end

	recargando = false
	actualizarGUI(true)
end

UIS.InputBegan:Connect(function(input, proc)
	if proc or Tool.Parent ~= Character then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then disparar()
	elseif input.KeyCode == Enum.KeyCode.R then recargar() end
end)

RunService.RenderStepped:Connect(function()
	if IsAimingValue.Value and RootPart and Tool.Parent == Character then
		local rot = math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
		RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, rot + math.pi, 0)
	end
end)

Tool.Equipped:Connect(function() 
	actualizarGUI(true)
	-- Conectar evento para actualizar si recoges balas del piso
	local ammoVal = obtenerReserva()
	if ammoVal then
		ammoVal.Changed:Connect(function()
			if Tool.Parent == Character then actualizarGUI(true) end
		end)
	end
end)

Tool.Unequipped:Connect(function() actualizarGUI(false) end)]]></ProtectedString>
