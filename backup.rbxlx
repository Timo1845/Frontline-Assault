					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">20cd82862736d90a0adffc6f00000c8c</UniqueId>
					<string name="Name">ServerScriptService_RoundManager</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1333d5215a2be5650b0775a300000d20</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBXA61A3FBB56254B8EACDD8DE69178FFFA">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--[[
	BattlePassSystem — serveur uniquement.
	Gère le chargement, la sauvegarde, la synchronisation des données et l'XP.
	Le serveur reste l'unique autorité sur la progression du joueur.
]]

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

---------------------------------------------------------------------------
-- CONFIGURATION ET DONNÉES EN MÉMOIRE
---------------------------------------------------------------------------

local configModule = ReplicatedStorage:FindFirstChild("BattlePassConfig")
if not configModule or not configModule:IsA("ModuleScript") then
	warn("[BattlePass] BattlePassConfig est absent ou n'est pas un ModuleScript ; système arrêté.")
	return
end

local successConfig, Config = pcall(require, configModule)
if not successConfig or type(Config) ~= "table" then
	warn("[BattlePass] Impossible de charger BattlePassConfig : " .. tostring(Config))
	return
end

local BattlePassStore = DataStoreService:GetDataStore(Config.DataStoreName)
local playerData = {} -- [UserId] = { level, xp, coins, claimed, skins, receipts }
local premiumPlayers = {} -- [UserId] = true si le joueur possède le game pass premium
local savingPlayers = {} -- Verrou de sauvegarde par UserId

local LOAD_ATTEMPTS = 5
local SAVE_ATTEMPTS = 5
local RETRY_DELAY = 1
local AUTOSAVE_INTERVAL = 120
local LOAD_FAILURE_MESSAGE = "Impossible de charger ta progression, reconnecte-toi dans quelques instants"

---------------------------------------------------------------------------
-- OUTILS DE NETTOYAGE ET DE COPIE
---------------------------------------------------------------------------

local function cleanInteger(value, defaultValue)
	local number = tonumber(value)
	if not number or number ~= number or number == math.huge or number == -math.huge then
		return defaultValue
	end
	return math.max(0, math.floor(number))
end

local function cleanFlagMap(source)
	local result = {}
	if type(source) ~= "table" then
		return result
	end

	for key, value in pairs(source) do
		if value == true and (type(key) == "string" or type(key) == "number") then
			result[tostring(key)] = true
		end
	end
	return result
end

local function normalizeData(source)
	if type(source) ~= "table" then
		source = {}
	end

	local level = cleanInteger(source.level, 1)
	level = math.clamp(level, 1, Config.MaxLevel)

	local data = {
		level = level,
		xp = cleanInteger(source.xp, 0),
		coins = cleanInteger(source.coins, 0),
		claimed = cleanFlagMap(source.claimed),
		skins = cleanFlagMap(source.skins),
		receipts = cleanFlagMap(source.receipts),
	}

	-- Convertit tout XP excédentaire en niveaux, sans perdre le reste.
	if data.level >= Config.MaxLevel then
		data.level = Config.MaxLevel
		data.xp = 0
	else
		while data.level < Config.MaxLevel and data.xp >= Config.XPPerLevel do
			data.xp -= Config.XPPerLevel
			data.level += 1
		end
		if data.level >= Config.MaxLevel then
			data.xp = 0
		end
	end

	return data
end

local function copyMap(source)
	local result = {}
	for key, value in pairs(source) do
		if value == true then
			result[key] = true
		end
	end
	return result
end

local function copyData(data)
	return {
		level = data.level,
		xp = data.xp,
		coins = data.coins,
		claimed = copyMap(data.claimed),
		skins = copyMap(data.skins),
		receipts = copyMap(data.receipts),
	}
end

---------------------------------------------------------------------------
-- OBJETS DE RÉPLICATION SUR LE JOUEUR
---------------------------------------------------------------------------

local function getOrCreateValue(parent, name, className)
	local value = parent:FindFirstChild(name)
	if value then
		if value.ClassName == className then
			return value
		end
		warn(string.format("[BattlePass] %s existe sous le mauvais type (%s, attendu %s).", value:GetFullName(), value.ClassName, className))
		return nil
	end

	value = Instance.new(className)
	value.Name = name
	value.Parent = parent
	return value
end

local function getOrCreateFolder(parent, name)
	return getOrCreateValue(parent, name, "Folder")
end

local function syncFlagFolder(folder, flags)
	if not folder then
		return
	end

	-- Met à jour les entrées déjà répliquées, y compris celles devenues fausses.
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BoolValue") then
			child.Value = flags[child.Name] == true
		end
	end

	-- Crée les entrées manquantes présentes dans les données du serveur.
	for name, owned in pairs(flags) do
		if owned then
			local value = getOrCreateValue(folder, name, "BoolValue")
			if value then
				value.Value = true
			end
		end
	end
end

local function syncPlayer(player)
	local data = playerData[player.UserId]
	if not data or player.Parent ~= Players then
		return
	end

	local levelValue = getOrCreateValue(player, "BP_Level", "IntValue")
	local xpValue = getOrCreateValue(player, "BP_XP", "IntValue")
	local coinsValue = getOrCreateValue(player, "BP_Coins", "IntValue")
	local premiumValue = getOrCreateValue(player, "BP_Premium", "BoolValue")

	if levelValue then levelValue.Value = data.level end
	if xpValue then xpValue.Value = data.xp end
	if coinsValue then coinsValue.Value = data.coins end
	if premiumValue then premiumValue.Value = premiumPlayers[player.UserId] == true end

	syncFlagFolder(getOrCreateFolder(player, "BP_Skins"), data.skins)
	syncFlagFolder(getOrCreateFolder(player, "BP_Claimed"), data.claimed)
end

---------------------------------------------------------------------------
-- CHARGEMENT ET SAUVEGARDE DU DATASTORE
---------------------------------------------------------------------------

local function loadPlayerData(player)
	local key = tostring(player.UserId)
	local success, storedData

	for attempt = 1, LOAD_ATTEMPTS do
		success, storedData = pcall(function()
			return BattlePassStore:GetAsync(key)
		end)
		if success then
			return normalizeData(storedData)
		end

		warn(string.format("[BattlePass] Chargement échoué pour %s (essai %d/%d) : %s", player.Name, attempt, LOAD_ATTEMPTS, tostring(storedData)))
		if attempt < LOAD_ATTEMPTS then
			task.wait(RETRY_DELAY)
		end
	end

	return nil
end

local function savePlayerData(player)
	local userId = player.UserId
	while savingPlayers[userId] do
		task.wait(0.1)
	end

	local data = playerData[userId]
	if not data then
		return false
	end

	savingPlayers[userId] = true
	local key = tostring(userId)
	local success, err

	for attempt = 1, SAVE_ATTEMPTS do
		local snapshot = copyData(data)
		success, err = pcall(function()
			BattlePassStore:UpdateAsync(key, function(_oldData)
				return snapshot
			end)
		end)
		if success then
			break
		end

		warn(string.format("[BattlePass] Sauvegarde échouée pour %s (essai %d/%d) : %s", player.Name, attempt, SAVE_ATTEMPTS, tostring(err)))
		if attempt < SAVE_ATTEMPTS then
			task.wait(RETRY_DELAY)
		end
	end

	savingPlayers[userId] = nil
	return success == true
end

local function saveAllLoadedPlayers()
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if playerData[player.UserId] then
			pending += 1
			task.spawn(function()
				local saved = savePlayerData(player)
				if not saved then
					warn("[BattlePass] Sauvegarde finale/autosave non confirmée pour " .. player.Name)
				end
				pending -= 1
			end)
		end
	end

	while pending > 0 do
		task.wait(0.1)
	end
end

---------------------------------------------------------------------------
-- PROGRESSION XP
---------------------------------------------------------------------------

local function addXP(player, amount)
	local data = playerData[player.UserId]
	if not data or data.level >= Config.MaxLevel then
		return
	end

	data.xp += cleanInteger(amount, 0)
	while data.level < Config.MaxLevel and data.xp >= Config.XPPerLevel do
		data.xp -= Config.XPPerLevel
		data.level += 1
		print(string.format("[BattlePass] %s atteint le niveau %d.", player.Name, data.level))
	end

	if data.level >= Config.MaxLevel then
		data.level = Config.MaxLevel
		data.xp = 0
	end

	syncPlayer(player)
end

---------------------------------------------------------------------------
-- JOUEURS ET ÉLIMINATIONS DU BLASTER
---------------------------------------------------------------------------

local function setupPlayer(player)
	if playerData[player.UserId] then
		return
	end

	local data = loadPlayerData(player)
	if player.Parent ~= Players then
		return -- Le joueur a quitté pendant le chargement : aucun objet ni sauvegarde.
	end
	if not data then
		warn("[BattlePass] Progression non chargée ; expulsion de " .. player.Name .. ".")
		player:Kick(LOAD_FAILURE_MESSAGE)
		return -- Ne jamais créer ni sauvegarder de données par défaut après un échec.
	end

	-- Vérifie le pass après le chargement, sans bloquer le chargement des données si l'API échoue.
	local isPremium = false
	local gamePassId = Config.PremiumGamePassId
	if type(gamePassId) == "number" and gamePassId > 0 then
		local success, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamePassId)
		end)
		if success then
			isPremium = ownsPass == true
		else
			warn(string.format("[BattlePass] Vérification du Game Pass premium échouée pour %s : %s", player.Name, tostring(ownsPass)))
		end
	end

	if player.Parent ~= Players then
		return -- Le joueur est parti pendant la vérification du Game Pass.
	end

	playerData[player.UserId] = data
	premiumPlayers[player.UserId] = isPremium

	syncPlayer(player)
	print(string.format("[BattlePass] %s chargé : niveau %d, %d XP, %d pièces, premium=%s.", player.Name, data.level, data.xp, data.coins, tostring(isPremium)))
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(setupPlayer, player)
end)

Players.PlayerRemoving:Connect(function(player)
	if playerData[player.UserId] then
		local saved = savePlayerData(player)
		if not saved then
			warn("[BattlePass] Progression de " .. player.Name .. " non sauvegardée après les tentatives prévues.")
		end
		playerData[player.UserId] = nil
		premiumPlayers[player.UserId] = nil
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(setupPlayer, player)
end

-- Le Blaster émet cet événement uniquement lors d'une élimination.
local blasterFolder = ServerScriptService:WaitForChild("Blaster", 10)
local eventsFolder = blasterFolder and blasterFolder:WaitForChild("Events", 10)
local eliminatedEvent = eventsFolder and eventsFolder:WaitForChild("Eliminated", 10)

if eliminatedEvent and eliminatedEvent:IsA("BindableEvent") then
	eliminatedEvent.Event:Connect(function(killer, taggedHumanoid, _damage)
		if not killer or not killer:IsA("Player") or killer.Parent ~= Players then
			return
		end
		if not taggedHumanoid or not taggedHumanoid:IsA("Humanoid") then
			return
		end

		local victimCharacter = taggedHumanoid:FindFirstAncestorOfClass("Model")
		local victimPlayer = victimCharacter and Players:GetPlayerFromCharacter(victimCharacter)
		if not victimPlayer or victimPlayer == killer then
			return -- Cible d'entraînement, victime non-joueur ou suicide.
		end
		if not killer.Team or not victimPlayer.Team or killer.Team == victimPlayer.Team then
			return -- Équipes absentes ou alliées : aucun XP.
		end

		addXP(killer, Config.XPPerKill)
	end)
else
	warn("[BattlePass] ATTENTION : ServerScriptService.Blaster.Events.Eliminated introuvable ou de type incorrect ; l'XP d'élimination est désactivée.")
end

---------------------------------------------------------------------------
-- REMOTES DU BATTLE PASS
---------------------------------------------------------------------------

local function ensureRemote(name, className)
	local remote = ReplicatedStorage:FindFirstChild(name)
	if remote then
		if remote.ClassName == className then
			return remote
		end
		warn(string.format("[BattlePass] %s existe mais est de type %s (attendu %s) ; il n'est pas remplacé.", name, remote.ClassName, className))
		return nil
	end

	remote = Instance.new(className)
	remote.Name = name
	remote.Parent = ReplicatedStorage
	return remote
end

-- Récupère ou crée les remotes nécessaires, sans remplacer ceux de type incorrect.
local claimRewardRemote = ensureRemote("ClaimReward", "RemoteFunction")
local promptPremiumEvent = ensureRemote("PromptPremiumEvent", "RemoteEvent")
local promptPurchaseEvent = ensureRemote("PromptPurchaseEvent", "RemoteEvent")

--------------------------------------------------------------------------
-- ACHAT DU GAME PASS PREMIUM
--------------------------------------------------------------------------

if promptPremiumEvent then
	promptPremiumEvent.OnServerEvent:Connect(function(player)
		local gamePassId = Config.PremiumGamePassId
		if type(gamePassId) ~= "number" or gamePassId <= 0 then
			warn("[BattlePass] Achat premium demandé, mais PremiumGamePassId vaut 0 ou est invalide.")
			return
		end
		if not playerData[player.UserId] or premiumPlayers[player.UserId] == true then
			return
		end

		local success, err = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, gamePassId)
		end)
		if not success then
			warn(string.format("[BattlePass] Impossible d'ouvrir l'achat premium pour %s : %s", player.Name, tostring(err)))
		end
	end)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
	if gamePassId ~= Config.PremiumGamePassId or not wasPurchased then
		return
	end
	if not player or player.Parent ~= Players or not playerData[player.UserId] then
		return
	end

	premiumPlayers[player.UserId] = true
	local premiumValue = player:FindFirstChild("BP_Premium")
	if premiumValue and premiumValue:IsA("BoolValue") then
		premiumValue.Value = true
	else
		syncPlayer(player)
	end
end)

--------------------------------------------------------------------------
-- RÉCUPÉRATION DES RÉCOMPENSES (VALIDATION CÔTÉ SERVEUR)
--------------------------------------------------------------------------

if claimRewardRemote then
	claimRewardRemote.OnServerInvoke = function(player, requestedLevel, track)
		-- 1. Valide strictement le palier et la piste reçus du client.
		if type(requestedLevel) ~= "number" or requestedLevel ~= requestedLevel or math.abs(requestedLevel) == math.huge then
			return false, "Le palier demandé est invalide."
		end
		local level = math.floor(requestedLevel)
		if track ~= "free" and track ~= "premium" then
			return false, "La piste demandée est invalide."
		end

		-- 2. Les données du joueur doivent être chargées.
		local data = playerData[player.UserId]
		if not data then
			return false, "Tes données Battle Pass ne sont pas encore chargées."
		end

		-- 3. Le palier doit exister dans la configuration.
		local levelRewards = Config.Rewards and Config.Rewards[level]
		if type(levelRewards) ~= "table" then
			return false, "Ce palier n'existe pas."
		end

		-- 4. Le joueur doit avoir atteint le palier.
		if data.level < level then
			return false, "Tu n'as pas encore atteint ce palier."
		end

		-- 5. La piste premium exige le Game Pass.
		if track == "premium" and premiumPlayers[player.UserId] ~= true then
			return false, "Le Battle Pass premium est requis pour cette récompense."
		end

		-- 6. Une même récompense ne peut être récupérée qu'une seule fois.
		local claimKey = track .. "_" .. tostring(level)
		if data.claimed[claimKey] then
			return false, "Cette récompense a déjà été récupérée."
		end

		-- 7. Vérifie la récompense configurée et ses données avant toute mutation.
		local reward = levelRewards[track]
		if type(reward) ~= "table" then
			return false, "Cette piste ne contient aucune récompense pour ce palier."
		end
		local coinAmount
		local skinId
		if reward.type == "coins" then
			if type(reward.amount) ~= "number" or reward.amount ~= reward.amount or math.abs(reward.amount) == math.huge or reward.amount < 0 then
				return false, "La récompense en pièces est mal configurée."
			end
			coinAmount = math.floor(reward.amount)
		elseif reward.type == "skin" then
			if type(reward.id) ~= "string" or reward.id == "" then
				return false, "La récompense cosmétique est mal configurée."
			end
			skinId = reward.id
		else
			return false, "Le type de récompense est invalide."
		end

		-- Aucun yield entre les vérifications et la mutation : évite les doubles récupérations concurrentes.
		data.claimed[claimKey] = true
		if coinAmount then
			data.coins += coinAmount
		else
			data.skins[skinId] = true
		end
		syncPlayer(player)

		-- La sauvegarde continue en arrière-plan après confirmation locale du serveur.
		task.spawn(function()
			if not savePlayerData(player) then
				warn(string.format("[BattlePass] Sauvegarde de la récompense %s échouée pour %s.", claimKey, player.Name))
			end
		end)

		if coinAmount then
			return true, string.format("Récompense récupérée : %d pièces !", coinAmount)
		end
		return true, string.format("Récompense récupérée : %s !", reward.name or skinId)
	end
end

--------------------------------------------------------------------------
-- ACHAT D'UN NIVEAU (DEVELOPER PRODUCT)
--------------------------------------------------------------------------

if promptPurchaseEvent then
	promptPurchaseEvent.OnServerEvent:Connect(function(player)
		local data = playerData[player.UserId]
		if not data or data.level >= Config.MaxLevel then
			return
		end
		if type(Config.LevelProductId) ~= "number" or Config.LevelProductId <= 0 then
			warn("[BattlePass] LevelProductId est invalide ; achat de niveau impossible.")
			return
		end

		local success, err = pcall(function()
			MarketplaceService:PromptProductPurchase(player, Config.LevelProductId)
		end)
		if not success then
			warn(string.format("[BattlePass] Impossible d'ouvrir l'achat de niveau pour %s : %s", player.Name, tostring(err)))
		end
	end)
end

-- Un seul gestionnaire ProcessReceipt doit être défini dans toute l'expérience.
MarketplaceService.ProcessReceipt = function(receiptInfo)
	if not receiptInfo or receiptInfo.ProductId ~= Config.LevelProductId then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = playerData[player.UserId]
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if type(receiptInfo.PurchaseId) ~= "string" or receiptInfo.PurchaseId == "" then
		warn("[BattlePass] Reçu de produit sans PurchaseId valide ; traitement reporté.")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchaseId = receiptInfo.PurchaseId
	if not data.receipts[purchaseId] then
		-- L'identifiant est noté avant l'effet ; aucune opération yieldante ne sépare les deux.
		data.receipts[purchaseId] = true
		if data.level >= Config.MaxLevel then
			data.coins += Config.MaxLevelCompensationCoins
		else
			data.level += 1
			data.xp = 0
		end
	end

	syncPlayer(player)
	if savePlayerData(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	warn(string.format("[BattlePass] Reçu %s appliqué en mémoire mais non sauvegardé pour %s ; traitement reporté.", purchaseId, player.Name))
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

----------------------------------------------------------------------------
-- SAUVEGARDES AUTOMATIQUES ET FERMETURE DU SERVEUR
---------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)
		saveAllLoadedPlayers()
	end
end)

game:BindToClose(function()
	saveAllLoadedPlayers() -- Lance une sauvegarde parallèle et attend leur fin.
end)

print("[BattlePass] Données, sauvegarde, réplication et XP initialisés.")]]></ProtectedString>
