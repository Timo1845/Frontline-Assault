				<Item class="LocalScript" referent="RBX9C3052189FDE44978E7AF7EFA83AC47E">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent

-- Función para cambiar las colisiones
local function setToolCollisions(enabled)
	for _, part in pairs(Tool:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = enabled
			-- También desactivamos CanQuery para que la cámara no choque con el arma
			part.CanQuery = enabled 
		end
	end
end

Tool.Equipped:Connect(function()
	-- Desactivar colisiones al equipar
	setToolCollisions(false)
end)

Tool.Unequipped:Connect(function()
	-- Opcional: Reactivarlas al soltarla si la herramienta se queda en el suelo
	setToolCollisions(true)
end)]]></ProtectedString>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<token name="RunContext">0</token>
						<string name="ScriptGuid">{73AC5B76-E689-4C50-AF26-C2F6A3A29A1F}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">18014364149484288</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db7100000fc3</UniqueId>
						<string name="Name">Collides</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">2dd09ce98d5a46e90ad7db7100001ff8</UniqueId>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX6A34BFE3157845D892E8BC323E164305">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Remote = Tool:WaitForChild("DisparoEvent")

local function reproducirSonido(nombre, barrel)
	if not barrel then return end

	local sonido = Tool:FindFirstChild(nombre)
	if not sonido then return end

	local clon = sonido:Clone()
	clon.Parent = barrel
	clon:Play()

	game:GetService("Debris"):AddItem(clon, clon.TimeLength + 1)
end

Remote.OnServerEvent:Connect(function(player, humanoid, danio, accion)

	local character = player.Character
	local barrel = character and character:FindFirstChild("Barrel", true)

	if accion == "sonido_disparo" then
		reproducirSonido("SonidoDisparo", barrel)
		return
	end

	if accion == "sonido_recarga" then
		reproducirSonido("SonidoRecarga", barrel)
		return
	end

	if humanoid and humanoid:IsA("Humanoid") then
		humanoid:TakeDamage(danio)
	end
end)]]></ProtectedString>
