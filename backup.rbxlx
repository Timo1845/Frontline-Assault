					<bool name="DefinesCapabilities">true</bool>
					<UniqueId name="HistoryId">2dd09ce98d5a46e90ad7db7100001211</UniqueId>
					<string name="Name">ServerStorage_Setting</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
